---
import '../styles/components/hero.css';

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  imageMobile?: string;
  /** El text ja va imprès a la imatge (com al banner d'inici real): el títol
   * es manté per accessibilitat però visualment amagat. */
  textInImage?: boolean;
}

const { title, subtitle, image, imageMobile, textInImage = false } = Astro.props;
const style = [
  image ? `--hero-image: url(${image})` : '',
  imageMobile ? `--hero-image-mobile: url(${imageMobile})` : '',
]
  .filter(Boolean)
  .join('; ');
---

<section class="hero" style={style || undefined}>
  {!textInImage && <div class="hero__overlay"></div>}
  <div class="hero__content">
    <h1 class={textInImage ? 'sr-only' : undefined}>{title}</h1>
    {subtitle && <p class={textInImage ? 'sr-only' : undefined}>{subtitle}</p>}
  </div>
</section>
