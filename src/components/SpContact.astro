---
// PROVES MÒBIL del bloc "¿Hablamos? / ¿Quieres saber más?" — 3 variants compartides per
// Home, Internacional i Servicios. Només visibles a mòbil (veure mobile-proposals.css).
import '../styles/pages/mobile-proposals.css';

interface Props {
  title: string;
  text: string;
  /** Prefix de l'etiqueta de prova, p. ex. "Contacte" */
  label?: string;
}

const { title, text, label = 'Contacte' } = Astro.props;
---

<div class="sp-tag">Prova mòbil · {label} 1 · Bloc navy amb botó</div>
<section class="sp sp--navy sp-ct1">
  <div class="container sp-stack">
    <h2>{title}</h2>
    <span class="sp-bar" aria-hidden="true"></span>
    <p>{text}</p>
    <a href="/contacto" class="sp-btn">Contactar <span aria-hidden="true">›</span></a>
  </div>
</section>

<div class="sp-tag">Prova mòbil · {label} 2 · Foto + enllaç</div>
<section class="sp sp--navy sp-ct2">
  <div class="sp-ct2__bg" aria-hidden="true"></div>
  <div class="sp-ct2__body">
    <h2>{title}</h2>
    <span class="sp-bar" aria-hidden="true"></span>
    <p>{text}</p>
    <a href="/contacto" class="sp-link">Contactar<span aria-hidden="true">›</span></a>
  </div>
</section>

<div class="sp-tag">Prova mòbil · {label} 3 · Accions directes</div>
<section class="sp sp-ct3">
  <div class="container sp-stack">
    <h2>{title}</h2>
    <span class="sp-bar" aria-hidden="true"></span>
    <p>{text}</p>
    <div class="sp-acts">
      <a href="/contacto" class="sp-act sp-act--solid">
        <span class="sp-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        <span class="sp-act__text">Escríbenos<small>Formulario de contacto</small></span>
        <span class="sp-act__arrow" aria-hidden="true">›</span>
      </a>
      <a href="tel:+34680310655" class="sp-act">
        <span class="sp-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        <span class="sp-act__text">Llámanos<small>+34 680 310 655</small></span>
        <span class="sp-act__arrow" aria-hidden="true">›</span>
      </a>
    </div>
  </div>
</section>
