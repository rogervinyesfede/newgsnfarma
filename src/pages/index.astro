---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import BusinessAreas from '../components/BusinessAreas.astro';
import '../styles/pages/home.css';
---

<BaseLayout
  title="GSN Farma Labs Group | Laboratorio farmacéutico"
  description="Laboratorio farmacéutico con más de 30 años de experiencia desarrollando soluciones de salud con visión global y ADN farmacéutico bajo el enfoque One Health Care."
>
  <Hero
    title="GSN Farma Labs Group"
    subtitle="Más de 30 años de experiencia y visión global en salud"
    image="/images/hero-home-desktop.jpg"
    imageMobile="/images/hero-home-mobile.jpg"
    textInImage
  />

  <section class="intro-section">
    <div class="container">
      <div class="intro-section__label">
        <p>GSN Farma Labs Group</p>
      </div>
      <div class="intro-section__content">
        <p>
          GSN Farma Labs Group es un grupo farmacéutico especializado en el desarrollo, fabricación,
          registro y comercialización de productos regulados de alta calidad y eficacia.
        </p>
        <p>
          Ofrecemos soluciones en <b>medicamentos, complementos alimenticios, productos sanitarios,
          cosméticos y biocidas</b>, cumpliendo en todo momento con los más altos estándares de
          <b>calidad, seguridad y trazabilidad.</b>
        </p>
        <a href="/servicios" class="btn">Descubre nuestros servicios</a>
      </div>
    </div>
  </section>

  <section
    class="about-preview"
    style="--about-image-mobile: url(/images/about-preview-mobile.webp); --about-image-desktop: url(/images/about-preview-desktop.webp)"
  >
    <div class="about-preview__heading">
      <span class="about-preview__pretitle">¿Quiénes somos?</span>
      <h2>Unidos por un compromiso inquebrantable con la salud de las personas.</h2>
    </div>

    <div class="about-preview__panel">
      <p>
        GSN Farma Labs Group nace de la unión de GSN Farma Labs y CoetusPharma, ambas empresas
        farmacéuticas con una sólida trayectoria en el desarrollo, registro, fabricación y
        comercialización de productos regulados.
      </p>
      <p>
        Con esta unión se suma la amplia experiencia de las dos compañías, permitiéndonos ofrecer
        una estructura integral altamente especializada, capaz de cubrir todo el ciclo de vida del
        producto y de dar respuesta a los retos actuales y futuros del sector.
      </p>
      <div class="about-preview__logos">
        <div>
          <span class="about-preview__logos-label">Promueve</span>
          <div class="about-preview__logos-row">
            <img src="/images/logo-social.png" alt="Socialdrive" />
            <img src="/images/logo-generalitat.png" alt="Generalitat de Catalunya" />
          </div>
        </div>
        <div>
          <span class="about-preview__logos-label">Financia</span>
          <div class="about-preview__logos-row">
            <img src="/images/logo-espana.png" alt="Gobierno de España" />
          </div>
        </div>
      </div>
      <a href="/quienes-somos" class="btn">Conoce más sobre el grupo</a>
    </div>
  </section>

  <BusinessAreas />

  <section class="home-contact">
    <div class="home-contact__form">
      <h2>¿Hablamos?</h2>
      <p>
        En GSN Farma Labs Group trabajamos como partner estratégico para impulsar soluciones en salud
        con visión a largo plazo.
      </p>
      <p>
        Si deseas ampliar información o explorar una posible colaboración para que te acompañemos en
        todo momento, ponte en contacto con nosotros.
      </p>
      <ContactForm dark />
    </div>
    <div class="home-contact__image">
      <img src="/images/home-prefooter.webp" alt="" loading="lazy" />
    </div>
  </section>
</BaseLayout>
