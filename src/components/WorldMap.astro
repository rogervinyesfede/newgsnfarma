---
// Mapa del món amb les regions on opera GSN Farma Labs Group. És el fitxer public/images/world-map.svg (vectorial, amb els seus estils
// dins) servit com a imatge: el navegador el descarrega una sola vegada i el reutilitza a desktop, mòbil i als tres idiomes, en lloc
// d'incrustar-lo (735 KB) dins de cada pàgina. Atribució del mapa dins del mateix SVG.
import '../styles/components/world-map.css';

interface Props {
  /** Text alternatiu del mapa (idioma de la pàgina). */
  label?: string;
}

const { label = 'Mapa del mundo con las regiones donde opera GSN Farma Labs Group' } = Astro.props;
---

<img class="world-map" src="/images/world-map.svg" width="1000" height="440" alt={label} loading="lazy" decoding="async" />
