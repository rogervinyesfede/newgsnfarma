---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/contacto.css';
---

<BaseLayout
  title="Contacto | GSN Farma Labs Group"
  description="Contacta con GSN Farma Labs Group para más información sobre nuestro laboratorio farmacéutico, servicios y soluciones de salud."
>
  <Hero title="Contacto" subtitle="Contacta con nosotros" />

  <section class="content-section">
    <div class="container">
      <h2>Cuéntanos en qué podemos ayudarte</h2>
      <p>Si quieres conocer más o explorar una colaboración, contacta con nosotros.</p>
      <ContactForm submitLabel="Enviar consulta" />
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2>Información de contacto</h2>
      <dl class="contact-info">
        <div>
          <dt>Dirección</dt>
          <dd>C/ del Llobregat nº 28, Terrassa, Barcelona, 08223</dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd><a href="tel:+34680310655">+34 680 310 655</a></dd>
        </div>
        <div>
          <dt>Correo electrónico</dt>
          <dd><a href="mailto:info@gsnfarma.com">info@gsnfarma.com</a></dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
