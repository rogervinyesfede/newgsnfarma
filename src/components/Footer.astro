---
import '../styles/components/footer.css';

const legalLinks = [
  { label: 'Aviso legal', href: '/aviso-legal' },
  { label: 'Política de privacidad', href: '/politica-de-privacidad' },
  { label: 'Política de cookies', href: '/politica-de-cookies' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__top-inner">
      <img src="/images/logo-gsn.svg" alt="GSN Farma Labs Group" class="site-footer__logo" />
      <a
        href="https://www.linkedin.com/company/gsn-farma"
        target="_blank"
        rel="noopener noreferrer"
        class="site-footer__social"
        aria-label="LinkedIn de GSN Farma Labs Group"
      >
        <img src="/images/icon-linkedin.svg" alt="" aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <p>Todos los derechos reservados © {year}</p>
      <nav aria-label="Menú legal">
        <ul>
          {legalLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
