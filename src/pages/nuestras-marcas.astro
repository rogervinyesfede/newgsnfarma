---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BrandCard from '../components/BrandCard.astro';
import brands from '../data/brands.json';
import '../styles/pages/inner-page.css';
import '../styles/pages/nuestras-marcas.css';

const areas = [
  { label: 'Medicamentos', icon: '/images/icon-medicamentos.svg' },
  { label: 'Salud natural', icon: '/images/icon-salud-natural.svg' },
  { label: 'Salud mujer', icon: '/images/icon-salud-mujer.svg' },
  { label: 'Salud animal', icon: '/images/icon-salud-animal.svg' },
  { label: 'Cosméticos', icon: '/images/icon-cosmeticos.svg' },
];
---

<BaseLayout
  title="Nuestras marcas | GSN Farma Labs Group"
  description="Marcas de salud desarrolladas bajo el modelo One Health Care, especializadas en medicamentos, salud natural, salud de la mujer y salud animal."
>
  <Hero
    split
    pretitle="Nuestras marcas"
    title="Siempre al servicio de la salud y el bienestar"
    image="/images/hero-nuestras-marcas.webp"
  />

  <section class="content-section content-section--wide">
    <div class="container">
      <h2>Áreas de especialización</h2>
      <p class="content-section__intro">
        GSN Farma Labs Group desarrolla y comercializa un portafolio de marcas propias en los
        ámbitos de salud natural, salud animal y medicamentos, integrando conocimiento farmacéutico,
        innovación y visión One Health.
      </p>
      <div class="areas-icons">
        {areas.map((area) => (
          <div class="areas-icons__item">
            <img src={area.icon} alt="" loading="lazy" />
            <p>{area.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section content-section--wide">
    <div class="container">
      <h2>Marcas con propósito</h2>
      <div class="brands-grid">
        {brands.map((brand) => (
          <BrandCard
            name={brand.name}
            category={brand.category}
            description={brand.description}
            url={brand.url}
            image={brand.image}
            logo={brand.logo}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
