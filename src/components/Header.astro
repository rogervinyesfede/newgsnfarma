---
import '../styles/components/header.css';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
const overlap = isHome || transparent;

const navItems = [
  { label: 'Quiénes somos', href: '/quienes-somos' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Nuestras marcas', href: '/nuestras-marcas' },
  { label: 'Internacional', href: '/internacional' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header class={`site-header${overlap ? '' : ' is-scrolled'}`} id="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Ir a la página de inicio">
      <img
        id="site-header-logo-img"
        src={overlap ? '/images/gsn_farma_labs_group_logo_white.png' : '/images/gsn_farma_labs_group_logo.png'}
        alt="GSN Farma Labs Group"
      />
    </a>

    <div class="site-header__right">
      <nav class="site-header__nav" aria-label="Navegación principal">
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-header__actions">
        <span class="site-header__divider" aria-hidden="true">|</span>
        <div class="site-header__lang-wrap">
          <button
            class="site-header__lang"
            id="lang-toggle"
            aria-label="Seleccionar idioma"
            aria-expanded="false"
            aria-controls="lang-dropdown"
          >
            <span>ES</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="site-header__lang-dropdown" id="lang-dropdown">
            <li><a href="/ca">CAT</a></li>
            <li><a href="/en">ENG</a></li>
          </ul>
        </div>

        <button
          class="site-header__toggle"
          id="nav-toggle"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="mobile-nav-overlay" id="mobile-nav-overlay"></div>
<nav class="mobile-nav" id="mobile-nav" aria-label="Navegación móvil">
  <button class="mobile-nav__close" id="mobile-nav-close" aria-label="Cerrar menú">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path></svg>
  </button>
  <ul class="mobile-nav__list">
    {navItems.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <a
    href="https://www.linkedin.com/company/gsn-farma"
    target="_blank"
    rel="noopener noreferrer"
    class="mobile-nav__social"
    aria-label="LinkedIn de GSN Farma Labs Group"
  >
    <img src="/images/icon-linkedin.svg" alt="" aria-hidden="true" />
  </a>
  <div class="mobile-nav__lang">
    <span class="is-active">ES</span>
    <a href="/ca">CAT</a>
    <a href="/en">ENG</a>
  </div>
</nav>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const closeBtn = document.getElementById('mobile-nav-close');
  const mobileNav = document.getElementById('mobile-nav');
  const overlay = document.getElementById('mobile-nav-overlay');

  function closeNav() {
    mobileNav?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    updateLogo();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open');
    overlay?.classList.toggle('is-open', !!isOpen);
    toggle.setAttribute('aria-expanded', String(!!isOpen));
    document.body.classList.toggle('nav-open', !!isOpen);
    updateLogo();
  });

  closeBtn?.addEventListener('click', closeNav);
  overlay?.addEventListener('click', closeNav);
  mobileNav?.querySelectorAll('.mobile-nav__list a').forEach((link) => {
    link.addEventListener('click', closeNav);
  });

  const langToggle = document.getElementById('lang-toggle');
  const langWrap = langToggle?.closest('.site-header__lang-wrap');

  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = langWrap?.classList.toggle('is-open');
    langToggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (langWrap?.classList.contains('is-open') && !langWrap.contains(e.target)) {
      langWrap.classList.remove('is-open');
      langToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Logo blanc (fitxer a part, no filtre CSS) quan el header és transparent
  // sobre el vídeo/foto; logo amb els colors originals quan el header és
  // sòlid o quan el menú mòbil és obert. Es feia amb un filter:brightness(0)
  // invert(1), però en fer-ne un transition en scroll el navegador promovia
  // la imatge a una capa composta i la reescalava amb una qualitat diferent,
  // fent que les lletres fines de "LABS GROUP" es veiessin lleugerament
  // diferents (més toves/esborrallades) respecte a les pàgines que ja
  // neixen amb el logo en color (sense haver passat mai pel filtre).
  const logoImg = document.getElementById('site-header-logo-img');
  const LOGO_WHITE = '/images/gsn_farma_labs_group_logo_white.png';
  const LOGO_COLOR = '/images/gsn_farma_labs_group_logo.png';

  function updateLogo() {
    if (!logoImg || !header) return;
    const showWhite = !header.classList.contains('is-scrolled') && !document.body.classList.contains('nav-open');
    const nextSrc = showWhite ? LOGO_WHITE : LOGO_COLOR;
    if (!logoImg.src.endsWith(nextSrc)) {
      logoImg.src = nextSrc;
    }
  }

  // El header ja neix "is-scrolled" (sòlid) a totes les pàgines excepte la home,
  // on comença transparent sobre el vídeo i es torna sòlid en fer scroll.
  if (header && !header.classList.contains('is-scrolled')) {
    const THRESHOLD = 60;
    const updateHeader = () => {
      header.classList.toggle('is-scrolled', window.scrollY > THRESHOLD);
      updateLogo();
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>
