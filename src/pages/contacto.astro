---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/contacto.css';
---

<BaseLayout
  title="Contacto | GSN Farma Labs Group"
  description="Contacta con GSN Farma Labs Group para más información sobre nuestro laboratorio farmacéutico, servicios y soluciones de salud."
>
  <Hero split pretitle="Contacto" title="Contacta con nosotros" image="/images/hero-contacto.webp" />

  <section class="content-section">
    <div class="container">
      <span class="pretitle">Cuéntanos en qué podemos ayudarte</span>
      <h2>Si quieres conocer más o explorar una colaboración, contacta con nosotros.</h2>
      <ContactForm submitLabel="Enviar consulta" />
    </div>
  </section>

  <section class="contact-info-section">
    <div class="contact-info-section__image">
      <img src="/images/contacto-img.webp" alt="" loading="lazy" />
    </div>
    <div class="contact-info-section__list">
      <div class="contact-info-row">
        <img src="/images/icon-marker.svg" alt="" aria-hidden="true" />
        <div>
          <h3>Dirección</h3>
          <p>C/ del Llobregat nº 28, Terrassa, Barcelona, 08223</p>
        </div>
      </div>
      <div class="contact-info-row">
        <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
        <div>
          <h3>Teléfono</h3>
          <p><a href="tel:+34680310655">+34 680 310 655</a></p>
        </div>
      </div>
      <div class="contact-info-row">
        <img src="/images/icon-address.svg" alt="" aria-hidden="true" />
        <div>
          <h3>Correo electrónico</h3>
          <p><a href="mailto:info@gsnfarma.com">info@gsnfarma.com</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
