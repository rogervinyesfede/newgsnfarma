---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/home-body-compare.css';
---

<BaseLayout
  title="GSN Farma Labs Group | Laboratorio farmacéutico"
  description="Laboratorio farmacéutico con más de 30 años de experiencia desarrollando soluciones de salud con visión global y ADN farmacéutico bajo el enfoque One Health Care."
>
  <Hero
    title="Un nuevo grupo farmacéutico"
    subtitle="Más de 30 años de experiencia y visión global en salud"
    image="/images/hero-video-frame.jpg"
    imageMobile="/images/hero-video-frame.jpg"
    video="/videos/video_gsn_farma.mp4"
    overlapHeader
    ctaLabel="Conócenos"
    ctaHref="/quienes-somos"
    largeText
    ctaOutline
  />

  <section class="block2-f block3-d__row--50-50 block3-d__row--onehealth">
    <div class="container">
      <div class="block2-f__image block2-f__image--blend">
        <img src="/images/one_health2.jpg" alt="Cápsula con naturaleza en su interior, símbolo del enfoque One Health" loading="lazy" />
      </div>
      <div class="block2-f__text">
        <div class="block2-f__accent-line"></div>
        <h2>One Health:<br />el propósito que nos guía</h2>
        <p>La salud de las personas, los animales y el entorno está profundamente conectada.</p>
        <p>
          Desarrollamos, fabricamos y comercializamos productos regulados con agilidad y rigor
          técnico, ofreciendo una salud integrada y sostenible.
        </p>
        <a href="/quienes-somos" class="block2-f__cta">
          <span class="block2-f__cta-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1b2435" stroke-width="2.4"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
          <span>Conoce más sobre el grupo</span>
        </a>
      </div>
    </div>
  </section>

  <section class="block3-d block3-d--compact">
    <section class="block2-f block3-d__row--50-50">
      <div class="container">
        <div class="block2-f__text">
          <div class="block2-f__accent-line"></div>
          <h2>Servicios Farmacéuticos</h2>
          <p>
            Unidad industrial con 17.000 m² para ofrecer servicios integrales en desarrollo,
            fabricación, aseguramiento de calidad, asuntos regulatorios y logística para
            productos regulados.
          </p>
          <a href="/servicios" class="block2-f__cta">
            <span class="block2-f__cta-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1b2435" stroke-width="2.4"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Ver todos los servicios</span>
          </a>
        </div>
        <div class="block2-f__image block2-f__image--muted">
          <img src="/images/services_home2.jpg" alt="Científica trabajando con microscopio en el laboratorio" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="block2-f block3-d__row--50-50">
      <div class="container">
        <div class="block2-f__image block2-f__image--muted block2-f__image--muted-strong">
          <img src="/images/brands_home_products2.jpg" alt="Mano sosteniendo iconos de productos de salud, representando el portafolio de marcas propias" loading="lazy" />
        </div>
        <div class="block2-f__text">
          <div class="block2-f__accent-line"></div>
          <h2>Marcas<br />Propias</h2>
          <p>
            Desarrollamos y comercializamos un portafolio de salud transversal, con medicamentos y
            productos de salud humana y animal, impulsados por la innovación y el rigor
            farmacéutico.
          </p>
          <a href="/nuestras-marcas" class="block2-f__cta">
            <span class="block2-f__cta-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1b2435" stroke-width="2.4"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Ver todas las marcas</span>
          </a>
        </div>
      </div>
    </section>
  </section>

  {/* ===== FI COMPARATIVA TEMPORAL ===== */}

  <section class="contact-alt contact-alt--photo">
    <div class="container">
      <h2>¿Hablamos?</h2>
      <p>
        En GSN Farma Labs Group trabajamos como partner estratégico para impulsar soluciones en
        salud con visión a largo plazo.
      </p>
      <a href="/contacto" class="btn btn--outline-white">Contactar</a>
    </div>
  </section>

  <section class="funding">
    <div class="container">
      <p class="funding__intro">Proyecto promovido con la colaboración de:</p>
      <div class="funding__groups">
        <div class="funding__group">
          <div class="funding__logos">
            <img src="/images/logo-social.png" alt="Economía Social" loading="lazy" />
            <img src="/images/logo-generalitat.png" alt="Generalitat de Catalunya" loading="lazy" />
          </div>
        </div>
        <div class="funding__group">
          <div class="funding__logos">
            <img src="/images/logo-espana.png" alt="Ministerio de Trabajo y Economía Social — SEPE" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>
