---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/quienes-somos-body-compare.css';
import '../styles/pages/desktop-page-header.css';
import '../styles/pages/quienes-somos-desktop-proposals.css';
import '../styles/pages/mobile-proposals.css';
import { detectPage, pathFor } from '../i18n/config';
import { about } from '../i18n/about';
import { ui } from '../i18n/ui';
import Facilities from '../components/Facilities.astro';
import GlobalPresence from '../components/GlobalPresence.astro';
import QdContact from '../components/QdContact.astro';
import SpContactBand from '../components/SpContactBand.astro';
import PageHeader from '../components/PageHeader.astro';
import BusinessAreasColorProposals from '../components/BusinessAreasColorProposals.astro';
import UnionTimeline from '../components/UnionTimeline.astro';
import PageHeaderMobile from '../components/PageHeaderMobile.astro';
import QuienesMobile from '../components/QuienesMobile.astro';

// Quiénes somos en els tres idiomes (l'idioma surt de la ruta); els textos són a src/i18n/about.ts.
// Dades dels blocs de mòbil (.qs-m*). Els blocs de desktop porten el seu text directament al marcat.
const { lang } = detectPage(Astro.url.pathname);
const c = about[lang];
const areaMeta = [
  { img: '/images/about_services2.jpg', imgMb: '/images/about_services_mb.jpg', muted: 'block2-f__image--muted', href: pathFor('services', lang) },
  { img: '/images/about_brands2.jpg', imgMb: '/images/about_brands_mb.jpg', muted: 'block2-f__image--muted block2-f__image--muted-strong', href: pathFor('brands', lang) },
];
const areas = c.areas.map((a, i) => ({ ...a, ...areaMeta[i] }));
const unionLogos = ['/images/gsn_farma_logo_cropped.png', '/images/coetus_logo_cropped.png'];
const union = {
  title: c.union.title,
  items: c.union.items.map((it, i) => ({ ...it, logo: unionLogos[i] })),
  footer: c.union.footer,
};
const oh = { ...c.oh, img: '/images/one_health_gsnfarma5.jpg' };
const hero = { ...c.hero, img: '/images/gsn_farma_offices_building4.jpg' };
const intro = c.intro;
const areasIntroMix = c.areasIntroMix;
---

<BaseLayout title={c.title} description={c.description}>
  {/* ===== Capçalera, versió DESKTOP (>=900px): banda de foto i fulla blanca arrodonida amb el títol i el subtítol centrats (veure PageHeader.astro). A mòbil s'amaga i el substitueix .qs-mhero. ===== */}

  <PageHeader lang={lang} />

  {/* ===== Capçalera, versió MÒBIL (<900px): foto de 220px sense degradat i fulla blanca arrodonida amb la barra cian, el títol i el paràgraf a l'esquerra (veure PageHeaderMobile.astro). A desktop s'amaga i es veu PageHeader. ===== */}
  <PageHeaderMobile title={c.intro.h2} text={c.intro.p} />

  {/* ===== Nuestra trayectoria, versió DESKTOP (>=900px): línia de temps a tota l'amplada, amb el contingut alineat a l'esquerra (veure UnionTimeline.astro). A mòbil s'amaga i el substitueix la part «union» de QuienesMobile.astro. ===== */}

  <UnionTimeline lang={lang} />

  {/* ===== Nuestra trayectoria, versió MÒBIL (<900px), definitiva: capçalera amb barra cian, títol i subtítol + línia de temps vertical sobre fons gris (veure QuienesMobile.astro, part «union»).
       A mòbil substitueix la unió de desktop (.qd-un, que s'amaga); a desktop és al revés. ===== */}
  <QuienesMobile lang={lang} part="union" />

  {/* ===== 3. Misión / propósito / One Health, versió DESKTOP (>=900px): composició partida sobre blanc amb la foto arrodonida a l'esquerra
       i, a la dreta, la línia cian a sobre del títol («One Health: el propósito que nos guía»), el destacat i el text. A mòbil s'amaga i el substitueix .qs-moh. ===== */}

  <section class="qd qd-oh" id="one-health">
    <div class="qd-wrap qd-oh__grid">
      <div class="qd-oh__photo"><img src={oh.img} alt={oh.alt} loading="lazy" /></div>
      <div class="qd-oh__text">
        <span class="qd-bar" aria-hidden="true"></span>
        <h2 set:html={oh.title}></h2>
        <p class="qd-oh__lead" set:html={oh.p1}></p>
        <p set:html={oh.p2}></p>
      </div>
    </div>
  </section>

  {/* ===== One Health, versió MÒBIL (<900px): foto amb el títol i la línia blava a sobre i una fulla blanca arrodonida
       amb el text. A mòbil substitueix el bloc de desktop (.qd-oh, que s'amaga); a desktop és al revés. ===== */}

  <section class="qs-moh" id="one-health-m">
    <div class="qs-moh__photo">
      <img src={oh.img} alt={oh.alt} loading="lazy" />
      <div class="qs-moh__over">
        <h2 set:html={oh.title}></h2>
        <span class="qs-moh__bar" aria-hidden="true"></span>
      </div>
    </div>
    <div class="qs-moh__sheet">
      <p class="qs-moh__lead" set:html={oh.p1}></p>
      <p set:html={oh.p2}></p>
    </div>
  </section>


  {/* ===== Áreas de negocio, versió MÒBIL (<900px), definitiva: títol, barra cian i subtítol + dues targetes de color amb la foto emmarcada sobre fons navy (veure QuienesMobile.astro, part «areas»).
       A mòbil substitueix el bloc de desktop (.qd-ag, que s'amaga); a desktop és al revés. ===== */}
  <QuienesMobile lang={lang} part="areas" />
  {/* Blocs mòbils definitius de «Nuestras instalaciones» i «Presencia global». */}
  <QuienesMobile lang={lang} part="fac" />
  <QuienesMobile lang={lang} part="glob" />



  {/* ===== 4. Áreas de negocio, versió DESKTOP (>=900px): bloc navy amb cantonades superiors arrodonides, títol centrat amb la línia cian a sobre i dos
       panells amb foto (zoom i fletxa en passar-hi el ratolí). A mòbil s'amaga i el substitueix la part «areas» de QuienesMobile.astro. ===== */}

  {/* OCULT (no esborrat): versió actual d'«Áreas de negocio». Es torna a mostrar canviant `false` per `true`. */}
  {false && (<>
  <div class="qd-tag qd-tag--keep">Áreas de negocio · Actual (targetes amb foto a sang i degradat navy)</div>
  <section class="qd qd-ag">
    <div class="qd-wrap">
      <div class="qd-ag__head">
        <span class="qd-bar" aria-hidden="true"></span>
        <h2>{c.areasHeading}</h2>
        <p set:html={areasIntroMix}></p>
      </div>
      <div class="qd-ag__panels">
        {areas.map((a) => (
          <a class="qd-ag__panel" href={a.href}>
            <img src={a.imgMb} alt={a.alt} loading="lazy" />
            <div class="qd-ag__body">
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="qd-cta">{a.cta}<span aria-hidden="true">›</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  </>)}

  {/* PROPOSTES addicionals (temporals, només desktop) de «Áreas de negocio»: mateix plantejament amb les targetes de colors diferents. */}
  <BusinessAreasColorProposals lang={lang} bare />

  {/* «Nuestras instalaciones» (desktop >=900px): xifra, llista dels cinc espais i foto gran, a continuació del bloc d'àrees de negoci. */}
  <Facilities lang={lang} />

  {/* «Presencia global» (desktop >=900px): mapa i regions d'Internacional, a continuació d'Instalaciones. */}
  <GlobalPresence lang={lang} />

  {/* ¿Quieres saber más?, versió DESKTOP (>=900px): bloc de contacte compartit (veure QdContact.astro), com a Servicios i Nuestras marcas. A mòbil s'amaga i el substitueix SpContactBand. */}
  <QdContact text={c.contactText} />

  {/* ¿Quieres saber más?, versió MÒBIL (<900px), definitiva: banda centrada amb el CTA en enllaç de text (SpContactBand), com a Servicios i Nuestras marcas. A desktop s'amaga. */}
  <SpContactBand title={ui[lang].contactBand.title} text={c.contactText} href={pathFor('contact', lang)} label={ui[lang].contactBand.label} />

</BaseLayout>
