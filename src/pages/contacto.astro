---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/contact-2col-compare.css';
import '../styles/pages/mobile-hero.css';
import '../styles/pages/mobile-proposals.css';
---

<BaseLayout
  title="Contacto | GSN Farma Labs Group"
  description="Contacta con GSN Farma Labs Group para más información sobre nuestro laboratorio farmacéutico, servicios y soluciones de salud."
>
  <section class="mhp mhp--contact" style="--mhp-pos: center 65%">
    <div class="mhp__img"><img src="/images/gsn_farma_offices_hall2.jpg" alt="" loading="eager" /></div>
    <div class="mhp__sheet">
      <h1 class="mhp__title">Contacta con nosotros</h1>
      <span class="mhp__bar" aria-hidden="true"></span>
      <p class="mhp__sub">Si quieres conocer más o explorar una colaboración, contacta con nosotros.</p>
    </div>
  </section>

  <section class="subpage-hero-e subpage-hero-e--left subpage-hero-e--contacto">
    <img src="/images/gsn_farma_offices_hall2.jpg" alt="" loading="eager" />
    <div class="subpage-hero-e__scrim"></div>
    <div class="subpage-hero-e__inner">
      <h1>Contacta con nosotros</h1>
    </div>
  </section>

  <section class="contact-2col contact-2col--f1">
    <div class="contact-2col__info">
      <div class="contact-2col__info-inner">
        <div class="contact-2col__info-row">
          <img src="/images/icon-marker.svg" alt="" aria-hidden="true" />
          <div>
            <h3>Dirección</h3>
            <p>C/ del Llobregat 28, 08223.<br />Terrassa, Barcelona.</p>
          </div>
        </div>
        <div class="contact-2col__info-row">
          <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
          <div>
            <h3>Información general</h3>
            <p><a href="tel:+34680310655">+34 680 310 655</a></p>
          </div>
        </div>
        <div class="contact-2col__info-row">
          <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
          <div>
            <h3>Farmacovigilancia</h3>
            <p><a href="tel:+34680310655">+34 680 310 655</a></p>
          </div>
        </div>
        <div class="contact-2col__info-row">
          <img src="/images/icon-address.svg" alt="" aria-hidden="true" />
          <div>
            <h3>Correo electrónico</h3>
            <p><a href="mailto:info@gsnfarma.com">info@gsnfarma.com</a></p>
          </div>
        </div>
        <a
          href="https://www.linkedin.com/company/gsn-farma"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-2col__social"
          aria-label="LinkedIn de GSN Farma Labs Group"
        >
          <img src="/images/icon-linkedin.svg" alt="" aria-hidden="true" />
        </a>
      </div>
    </div>
    <div class="contact-2col__form">
      <div class="contact-2col__form-inner">
        <p>Si quieres conocer más o explorar una colaboración, contacta con nosotros.</p>
        <ContactForm submitLabel="Enviar" />
      </div>
    </div>
  </section>



  {/* Formulari (mòbil <900px): mateixos estils que el del bloc de desktop (reutilitza .contact-2col), alineat a l'esquerra amb el marge de 16px de la resta de la pàgina. S'amaga a desktop. */}
  <section class="sp sp-cf">
    <div class="container">
      <div class="contact-2col">
        <ContactForm submitLabel="Enviar" />
      </div>
    </div>
  </section>

  {/* Dades de contacte (mòbil <900px): graella 2×2 alineada a l'esquerra (Dirección | Correo, Información general | Farmacovigilancia); LinkedIn és al peu. A desktop continuen les del bloc original. */}
  <section class="sp sp-cd">
    <div class="container">
      <div class="sp-cd__items">
        <div class="sp-cd__item">
          <img src="/images/icon-marker.svg" alt="" aria-hidden="true" />
          <h3>Dirección</h3>
          <p><a href="https://maps.google.com/?q=C/+del+Llobregat+28,+08223+Terrassa" target="_blank" rel="noopener noreferrer">C/ del Llobregat 28,<br />08223. Terrassa,<br />Barcelona.</a></p>
        </div>
        <div class="sp-cd__item">
          <img src="/images/icon-address.svg" alt="" aria-hidden="true" />
          <h3>Correo electrónico</h3>
          <p><a href="mailto:info@gsnfarma.com">info@gsnfarma.com</a></p>
        </div>
        <div class="sp-cd__item">
          <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
          <h3>Información general</h3>
          <p><a href="tel:+34680310655">+34 680 310 655</a></p>
        </div>
        <div class="sp-cd__item">
          <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
          <h3>Farmacovigilancia</h3>
          <p><a href="tel:+34680310655">+34 680 310 655</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
