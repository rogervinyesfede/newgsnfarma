---
import '../styles/components/header.css';
import { detectPage, pathFor, switchPath, LANGS } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const { lang, key } = detectPage(Astro.url.pathname);
const t = ui[lang];
const isHome = key === 'home';
const overlap = isHome || transparent;

// «Quiénes somos» té un desplegable amb els subapartats de la pàgina (ancoratges; textos a ui.ts → aboutMenu).
const aboutHref = pathFor('about', lang);
// A mòbil (<900px) encara no existeixen els blocs d'Instalaciones i Presencia global: els seus enllaços s'amaguen al menú mòbil fins que es dissenyin (data-d-only).
const desktopOnly = ['instalaciones', 'presencia-global'];
const aboutSub = t.aboutMenu.map((s) => ({ ...s, href: s.id ? `${aboutHref}#${s.id}` : aboutHref, dOnly: desktopOnly.includes(s.id) }));

const navItems = [
  { label: t.nav.about, href: aboutHref, sub: aboutSub },
  { label: t.nav.services, href: pathFor('services', lang) },
  { label: t.nav.brands, href: pathFor('brands', lang) },
  { label: t.nav.international, href: pathFor('international', lang) },
  { label: t.nav.contact, href: pathFor('contact', lang) },
];
// Selector d'idioma: la mateixa pàgina en els altres idiomes.
const otherLangs = LANGS.filter((l) => l !== lang).map((l) => ({ lang: l, label: t.langLabel[l], href: switchPath(key, l) }));
---

<header class={`site-header${overlap ? '' : ' is-scrolled'}`} id="site-header">
  <div class="site-header__inner">
    <a href={pathFor('home', lang)} class="site-header__logo" aria-label={t.header.goHome}>
      <img
        id="site-header-logo-img"
        src={overlap ? '/images/gsn_farma_labs_group_logo_white.png' : '/images/gsn_farma_labs_group_logo.png'}
        alt="GSN Farma Labs Group"
      />
    </a>

    <div class="site-header__right">
      <nav class="site-header__nav" aria-label={t.header.mainNav}>
        <ul>
          {navItems.map((item) => (
            <li class={item.sub ? 'has-sub' : undefined}>
              <a href={item.href}>
                {item.label}
                {item.sub && (
                  <svg class="site-header__chev" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
              {item.sub && (
                <div class="site-header__sub">
                  <ul>
                    {item.sub.map((s) => (
                      <li>
                        <a href={s.href}>{s.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header__actions">
        <span class="site-header__divider" aria-hidden="true">|</span>
        <div class="site-header__lang-wrap">
          <button
            class="site-header__lang"
            id="lang-toggle"
            aria-label={t.header.selectLang}
            aria-expanded="false"
            aria-controls="lang-dropdown"
          >
            <span>{t.langLabel[lang]}</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="site-header__lang-dropdown" id="lang-dropdown">
            {otherLangs.map((o) => <li><a href={o.href} hreflang={o.lang} lang={o.lang}>{o.label}</a></li>)}
          </ul>
        </div>

        <button
          class="site-header__toggle"
          id="nav-toggle"
          aria-label={t.header.openMenu}
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="mobile-nav-overlay" id="mobile-nav-overlay"></div>
<nav class="mobile-nav" id="mobile-nav" aria-label={t.header.mobileNav}>
  <button class="mobile-nav__close" id="mobile-nav-close" aria-label={t.header.closeMenu}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path></svg>
  </button>
  <ul class="mobile-nav__list">
    {navItems.map((item) => (
      <li class={item.sub ? 'has-sub' : undefined}>
        {item.sub ? (
          <>
            <div class="mobile-nav__row">
              <a href={item.href}>{item.label}</a>
              <button type="button" class="mobile-nav__expand" aria-expanded="false" aria-controls="mobile-sub-about" aria-label={t.header.expandSub}>
                <svg width="14" height="9" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <ul class="mobile-nav__sub" id="mobile-sub-about">
              {item.sub.map((s) => (
                <li data-d-only={s.dOnly ? '' : undefined}><a href={s.href} data-id={s.id}>{s.label}</a></li>
              ))}
            </ul>
          </>
        ) : (
          <a href={item.href}>{item.label}</a>
        )}
      </li>
    ))}
  </ul>
  <a
    href="https://www.linkedin.com/company/gsn-farma"
    target="_blank"
    rel="noopener noreferrer"
    class="mobile-nav__social"
    aria-label={t.header.linkedin}
  >
    <img src="/images/icon-linkedin.svg" alt="" aria-hidden="true" />
  </a>
  <div class="mobile-nav__lang">
    <span class="is-active">{t.langLabel[lang]}</span>
    {otherLangs.map((o) => <a href={o.href} hreflang={o.lang} lang={o.lang}>{o.label}</a>)}
  </div>
</nav>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const closeBtn = document.getElementById('mobile-nav-close');
  const mobileNav = document.getElementById('mobile-nav');
  const overlay = document.getElementById('mobile-nav-overlay');

  function closeNav() {
    mobileNav?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    updateLogo();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open');
    overlay?.classList.toggle('is-open', !!isOpen);
    toggle.setAttribute('aria-expanded', String(!!isOpen));
    document.body.classList.toggle('nav-open', !!isOpen);
    updateLogo();
  });

  closeBtn?.addEventListener('click', closeNav);
  overlay?.addEventListener('click', closeNav);
  mobileNav?.querySelectorAll('.mobile-nav__list a').forEach((link) => {
    link.addEventListener('click', closeNav);
  });

  // Menú mòbil: el botó del xevró desplega els subapartats de «Quiénes somos»; l'enllaç del títol porta a la pàgina.
  const expand = mobileNav?.querySelector<HTMLButtonElement>('.mobile-nav__expand');
  expand?.addEventListener('click', () => {
    const li = expand.closest('li');
    const isOpen = li?.classList.toggle('is-open');
    expand.setAttribute('aria-expanded', String(!!isOpen));
  });

  // Els ancoratges tenen un id a desktop i el mateix id amb «-m» a la versió mòbil (<900px): es salta a l'element que sigui visible, descomptant la capçalera fixa.
  const goToHash = (id: string) => {
    if (!id) return;
    const el = [id, id + '-m'].map((k) => document.getElementById(k)).find((e) => e && e.getClientRects().length > 0);
    if (!el) return;
    const top = el.getBoundingClientRect().top + window.scrollY - (header?.offsetHeight ?? 0);
    window.scrollTo({ top: Math.max(0, top), behavior: 'auto' });
  };

  mobileNav?.querySelectorAll<HTMLAnchorElement>('.mobile-nav__sub a, .mobile-nav__row a').forEach((link) => {
    link.addEventListener('click', (e) => {
      const url = new URL(link.href);
      if (url.pathname !== location.pathname) return; // altra pàgina: navegació normal (el salt es fa en carregar)
      e.preventDefault();
      history.pushState(null, '', url.pathname + url.hash);
      closeNav();
      // la pàgina és llarga i amb imatges mandroses: es torna a ajustar el salt mentre es carreguen les imatges de sobre
      const go = () => (url.hash ? goToHash(url.hash.slice(1)) : window.scrollTo({ top: 0, behavior: 'auto' }));
      requestAnimationFrame(go);
      [350, 900].forEach((d) => setTimeout(go, d));
    });
  });

  // En carregar una pàgina amb ancoratge, el navegador pot saltar a un element amagat (versió desktop a mòbil): es corregeix cap al visible.
  if (location.hash) {
    const fix = () => goToHash(decodeURIComponent(location.hash.slice(1)));
    window.addEventListener('load', () => { fix(); setTimeout(fix, 500); });
  }

  const langToggle = document.getElementById('lang-toggle');
  const langWrap = langToggle?.closest('.site-header__lang-wrap');

  langToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = langWrap?.classList.toggle('is-open');
    langToggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (langWrap?.classList.contains('is-open') && !langWrap.contains(e.target)) {
      langWrap.classList.remove('is-open');
      langToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Logo blanc (fitxer a part, no filtre CSS) quan el header és transparent
  // sobre el vídeo/foto; logo amb els colors originals quan el header és
  // sòlid o quan el menú mòbil és obert. Es feia amb un filter:brightness(0)
  // invert(1), però en fer-ne un transition en scroll el navegador promovia
  // la imatge a una capa composta i la reescalava amb una qualitat diferent,
  // fent que les lletres fines de "LABS GROUP" es veiessin lleugerament
  // diferents (més toves/esborrallades) respecte a les pàgines que ja
  // neixen amb el logo en color (sense haver passat mai pel filtre).
  const logoImg = document.getElementById('site-header-logo-img');
  const LOGO_WHITE = '/images/gsn_farma_labs_group_logo_white.png';
  const LOGO_COLOR = '/images/gsn_farma_labs_group_logo.png';

  function updateLogo() {
    if (!logoImg || !header) return;
    const showWhite = !header.classList.contains('is-scrolled') && !document.body.classList.contains('nav-open');
    const nextSrc = showWhite ? LOGO_WHITE : LOGO_COLOR;
    if (!logoImg.src.endsWith(nextSrc)) {
      logoImg.src = nextSrc;
    }
  }

  // El header ja neix "is-scrolled" (sòlid) a totes les pàgines excepte la home,
  // on comença transparent sobre el vídeo i es torna sòlid en fer scroll.
  if (header && !header.classList.contains('is-scrolled')) {
    const THRESHOLD = 60;
    const updateHeader = () => {
      header.classList.toggle('is-scrolled', window.scrollY > THRESHOLD);
      updateLogo();
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>
