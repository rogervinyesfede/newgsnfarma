---
import BaseLayout from '../layouts/BaseLayout.astro';
import brandsJson from '../data/brands.json';
import '../styles/pages/inner-page.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/brand-gate.css';
import '../styles/pages/desktop-page-header.css';
import '../styles/pages/marcas-desktop-proposals.css';
import '../styles/pages/mobile-proposals.css';
import QdContact from '../components/QdContact.astro';
import SpContactBand from '../components/SpContactBand.astro';
import PageHeaderCentered from '../components/PageHeaderCentered.astro';
import PageHeaderMobile from '../components/PageHeaderMobile.astro';
import BrandsGrid from '../components/BrandsGrid.astro';
import BrandsGridMobile from '../components/BrandsGridMobile.astro';
import { detectPage, pathFor } from '../i18n/config';
import { ui } from '../i18n/ui';
import { MEDICINES_PDF } from '../data/documents';
import { brandsCopy } from '../i18n/brands';

// Nuestras marcas en els tres idiomes (l'idioma surt de la ruta); els textos són a src/i18n/brands.ts i les marques a src/data/brands.json.
const { lang } = detectPage(Astro.url.pathname);
const c = brandsCopy[lang];
const brands = brandsJson.map((b, i) => ({ ...b, ...c.brands[i], ctaLabel: c.brands[i].cta }));

// PROVES MÒBIL (.sp): helpers per a les propostes de marques.
const brandLogo = (b: any) => (b.name === 'Medicamentos' ? '/images/gsnfarma_new_logo3.png' : b.logo);
const gridImg = (b: any) =>
  b.name === 'Nakama' ? '/images/brand-nakama-shifted2.jpg'
  : b.name === 'Orissens' ? '/images/brands_orissens-shifted.jpg'
  : b.name === 'Medicamentos' ? '/images/gsnfarma_card.jpg'
  : b.name === 'Esenciales' ? '/images/esenciales-farmacia.jpg'
  : b.image;
const stripImg = (b: any) => (b.name === 'Orissens' ? '/images/brands_orissens-shifted.jpg' : b.image);

// PROVES DESKTOP (.qd): helpers per a les propostes de logos i de franges de marca.
const cardLogo = (b: any) => (b.name === 'Medicamentos' ? '/images/gsnfarma_new_logo_white3.png' : b.name === 'Esenciales' ? '/images/logo_esenciales_white.webp' : b.logo);
const key = (b: any) => b.name.toLowerCase();
const ctaLabel = (b: any) => b.ctaLabel;
// PDF del llistat de medicaments: s'obre en una pestanya nova quan l'usuari confirma que és professional sanitari (popup d'accés professional).
const gatePdf = MEDICINES_PDF;
const descLines = (b: any) => b.description.split('\n');

// Graella desktop: 6 marques actuals (amb Esenciales just abans de Medicamentos, a diferència de l'ordre de les franges) i 2 de «Próximamente».
// GSN: a la graella de desktop es fa servir una versió de la foto amb llenç ampliat a dalt i a baix (marca_gsn_card.jpg) perquè els pots es vegin una mica més petits; el mòbil i la franja usen marca_gsn.jpg.
const gridCard = (b: any) => ({ key: key(b), alt: b.alt, category: b.category, img: b.name === 'GSN' ? '/images/marca_gsn_card.jpg' : gridImg(b), logo: cardLogo(b) });
const gridLive = ['orissens', 'gsn', 'nakama', 'herbaldi', 'esenciales', 'medicamentos'].map((k) => gridCard(brands.find((b: any) => key(b) === k)));
const gridSoon = ['ortopedia', 'dermo'].map((k) => gridCard(brands.find((b: any) => key(b) === k))).map(({ key, alt, img }) => ({ key, alt, img }));

// Graella de mòbil (2×4): mateixes marques i ordre que a desktop, amb logos amb els seus colors.
// GSN: com a desktop, versió de la foto amb llenç ampliat (els pots més petits i una mica més avall); la franja de GSN continua amb marca_gsn.jpg.
const mobileCard = (b: any) => ({ key: key(b), alt: b.alt, img: b.name === 'GSN' ? '/images/marca_gsn_card.jpg' : gridImg(b), logo: cardLogo(b) });
const mobileLive = ['orissens', 'gsn', 'nakama', 'herbaldi', 'esenciales', 'medicamentos'].map((k) => mobileCard(brands.find((b: any) => key(b) === k)));
const mobileSoon = ['ortopedia', 'dermo'].map((k) => { const m = mobileCard(brands.find((b: any) => key(b) === k)); return { key: m.key, alt: m.alt, img: m.img }; });

// Foto de capçalera de desktop (PROVA: header4, 2560×680, ja retallada a la proporció de la banda de 340px) en tres mides: el navegador tria la més petita que cobreix
// l'amplada de la pantalla (1280 → 50 KB, 1600 → 68 KB, resta/retina → la gran de 186 KB). Mòbil: header4_hm (retall 1204×680 centrat a l'esquerra, 828×468). Les imatges antigues (header3 / header2_hm) continuen a public/images.
const headerImg = '/images/gsn_farma_our_brands_header4.jpg';
const headerSrcset = [
  '/images/gsn_farma_our_brands_header4_1280.jpg 1280w',
  '/images/gsn_farma_our_brands_header4_1600.jpg 1600w',
  `${headerImg} 2560w`,
].join(', ');
---

<BaseLayout title={c.title} description={c.description}>
  {/* Capçalera de MÒBIL (<900px): foto de 220px SENSE degradat i fulla blanca arrodonida amb el títol, la barra cian i el subtítol, a l'esquerra (PageHeaderMobile.astro). A desktop s'amaga. */}
  <PageHeaderMobile title={c.header.title} text={c.header.text} img="/images/gsn_farma_our_brands_header4_hm" />

  {/* Capçalera de DESKTOP (>=900px): com la de Quiénes somos (PageHeaderCentered.astro): foto sense degradat i fulla blanca amb la barra cian, el títol (H1) i el subtítol, centrats. A mòbil s'amaga. */}
  <PageHeaderCentered img={headerImg} srcset={headerSrcset} pos={50} title={c.header.title} subtitle={c.header.text} />

  {/* Graella de targetes de marca, versió DESKTOP (>=900px): 6 marques actuals + 2 de «Próximamente» en una graella 4 × 2 (veure BrandsGrid.astro). A mòbil s'amaga i la substitueix BrandsGridMobile. */}
  <BrandsGrid live={gridLive} soon={gridSoon} legendNow={c.grid.legendNow} legendSoon={c.grid.legendSoon} soonLabel={c.grid.soonLabel} goTo={c.goTo} />

  {/* Graella de targetes de marca, versió MÒBIL (<900px): 6 marques actuals + 2 de «Próximamente», totes iguals, 2 columnes × 4 files (4 × 2 de 600 a 899px) (veure BrandsGridMobile.astro). A desktop s'amaga i es veu .qd-bg. */}
  <BrandsGridMobile live={mobileLive} soon={mobileSoon} legendNow={c.grid.legendNow} legendSoon={c.grid.legendSoon} soonLabel={c.grid.soonLabel} goTo={c.goTo} />

  {/* Franges de marca (mòbil <900px): foto a sang + fulla blanca amb el logo gran, la descripció i el CTA; la categoria va com a pastilla dins la foto. A desktop s'amaga i es veuen les franges .qd-mk. */}
  <section class="sp sp-mb2">
    {brands.map((brand) => (
      <div class="sp-mb2__item" id={`marca-${brand.name.toLowerCase()}-m`}>
        <div class="sp-photo">
          <img src={stripImg(brand)} alt="" loading="lazy" />
          <span class={`sp-mb2__pill${brand.soon ? ' sp-mb2__pill--soon' : ''}`}>{brand.category}</span>
        </div>
        <div class="sp-sheet">
          {brandLogo(brand) ? (
            <h2 class="sp-mb2__name"><img class={`sp-mb2__logo sp-mb2__logo--${brand.name.toLowerCase()}`} src={brandLogo(brand)} alt={brand.alt} loading="lazy" /></h2>
          ) : (
            <h2 class="sp-mb2__name sp-mb2__name--text">{brand.alt}</h2>
          )}
          <p>{brand.description.split('\n').map((line: string, idx: number) => (idx > 0 ? <><br />{line}</> : line))}</p>
          {brand.gated ? (
              <button type="button" class="sp-cta" data-gate-trigger>{brand.ctaLabel}<span aria-hidden="true">›</span></button>
            ) : brand.url ? (
              <a href={brand.url} {...(brand.url === '#' ? {} : { target: '_blank', rel: 'noopener noreferrer' })} class="sp-cta">{brand.ctaLabel}<span aria-hidden="true">›</span></a>
            ) : null}
        </div>
      </div>
    ))}
  </section>

  {/* Franges de marca, versió DESKTOP (>=900px): foto 16:9 arrodonida i, al costat, categoria, logo, text i CTA; alternen costat i fons (la primera franja, grisa). A mòbil s'amaguen i les substitueix .sp-mb2. */}

  {brands.map((brand, i) => (
    <section class={`qd qd-mk${i % 2 === 0 ? ' qd-mk--grey' : ' qd-mk--rev'}`} id={`marca-${key(brand)}`}>
      <div class="qd-wrap qd-mk__grid">
        <div class="qd-mk__photo"><img src={stripImg(brand)} alt="" loading="lazy" /></div>
        <div class="qd-mk__text">
          <span class={`qd-mk__pill${brand.soon ? ' qd-mk__pill--soon' : ''}`}>{brand.category}</span>
          {brandLogo(brand) ? (
            <h2 class="qd-mk__name"><img class={`qd-mk__logo qd-mk__logo--${key(brand)}`} src={brandLogo(brand)} alt={brand.alt} loading="lazy" /></h2>
          ) : (
            <h2 class="qd-mk__name qd-mk__name--text">{brand.alt}</h2>
          )}
          <p>{descLines(brand).map((line: string, n: number) => (n > 0 ? <><br />{line}</> : line))}</p>
          {brand.gated ? (
            <button type="button" class="qd-cta" data-gate-trigger>{ctaLabel(brand)}<span aria-hidden="true">›</span></button>
          ) : brand.url ? (
            <a href={brand.url} {...(brand.url === '#' ? {} : { target: '_blank', rel: 'noopener noreferrer' })} class="qd-cta">{ctaLabel(brand)}<span aria-hidden="true">›</span></a>
          ) : null}
        </div>
      </div>
    </section>
  ))}

  {/* ¿Quieres saber más?, versió DESKTOP (>=900px): bloc de contacte compartit (veure QdContact.astro). */}
  <QdContact text={c.contactText} />

  {/* ¿Quieres saber más?, versió MÒBIL (<900px): banda centrada amb el CTA en enllaç de text (SpContactBand), igual que a Home i Servicios. A desktop s'amaga. */}
  <SpContactBand title={ui[lang].contactBand.title} text={c.contactText} href={pathFor('contact', lang)} label={ui[lang].contactBand.label} />

  {/* ===== Popup d'accés restringit (marques amb "gated": true, ex. Medicamentos) ===== */}

  <div class="brand-gate" data-gate-modal hidden>
    <div class="brand-gate__overlay" data-gate-close></div>
    <div class="brand-gate__card" role="dialog" aria-modal="true" aria-labelledby="brand-gate-title">
      <h3 id="brand-gate-title" class="brand-gate__title">{c.gate.title}</h3>
      <p class="brand-gate__text">{c.gate.text}</p>
      <div class="brand-gate__actions">
        <a href={gatePdf} target="_blank" rel="noopener noreferrer" class="brand-gate__btn brand-gate__btn--primary" data-gate-close>{c.gate.yes}</a>
        <button type="button" class="brand-gate__btn brand-gate__btn--secondary" data-gate-close>
          {c.gate.no}
        </button>
      </div>
    </div>
  </div>

  <script>
    const modal = document.querySelector('[data-gate-modal]');
    const triggers = document.querySelectorAll('[data-gate-trigger]');
    const closers = document.querySelectorAll('[data-gate-close]');

    function openGate() {
      modal?.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeGate() {
      modal?.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }

    triggers.forEach((el) => el.addEventListener('click', openGate));
    closers.forEach((el) => el.addEventListener('click', closeGate));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeGate();
    });
  </script>

  </BaseLayout>
