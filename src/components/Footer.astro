---
// Footer únic de tot el web (mòbil i desktop): logo i LinkedIn a dalt; sota una línia fina, textos legals i copyright.
// Els telèfons i l'adreça ja són a Contacto, per això no es repeteixen aquí. Veure footer.css.
import '../styles/components/footer.css';
import { detectPage, pathFor } from '../i18n/config';
import { ui } from '../i18n/ui';

const { lang } = detectPage(Astro.url.pathname);
const t = ui[lang];
const legalLinks = [
  { label: t.footer.legal, href: pathFor('legal', lang) },
  { label: t.footer.privacy, href: pathFor('privacy', lang) },
  { label: t.footer.cookies, href: pathFor('cookies', lang) },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <img class="site-footer__logo" src="/images/gsn_farma_labs_group_logo.png" alt="GSN Farma Labs Group" />
      <a
        class="site-footer__in"
        href="https://www.linkedin.com/company/gsn-farma"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.header.linkedin}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9.5h4V21H3V9.5zm6.5 0h3.8v1.6h.06c.53-1 1.84-2 3.8-2 4.06 0 4.84 2.67 4.84 6.15V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7V21h-4V9.5z"></path></svg>
      </a>
    </div>
    <div class="site-footer__bottom">
      <nav class="site-footer__links" aria-label={t.footer.legalNav}>
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <p class="site-footer__copy">{t.footer.rights} {year}</p>
    </div>
  </div>
</footer>
