---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorldMap from '../components/WorldMap.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/components/world-map.css';
import '../styles/pages/internacional-body-compare.css';
import '../styles/pages/mobile-hero.css';
import '../styles/pages/mobile-proposals.css';
import SpContact from '../components/SpContact.astro';

// PROVES MÒBIL (.sp)
const regions = ['Europa', 'Oriente Medio', 'China', 'Sudeste Asiático', 'Oceanía', 'Latinoamérica'];
const catalogs = ['Medicamentos', 'Salud natural', 'Salud animal'];
---

<BaseLayout
  title="Internacional | GSN Farma Labs Group"
  description="Presencia internacional de GSN Farma Labs Group."
>
  <section class="mhp">
    <div class="mhp__img"><img src="/images/gsn_farma_offices_building3.jpg" alt="" loading="eager" /></div>
    <div class="mhp__sheet">
      <h1 class="mhp__title">Presencia Global</h1>
      <span class="mhp__bar" aria-hidden="true"></span>
      <h2 class="mhp__sub">GSN FARMA LABS GROUP en el mundo</h2>
      <p class="mhp__text">
        Tu partner global en soluciones de salud, con capacidad y presencia para operar en
        mercados de todo el mundo.
      </p>
    </div>
  </section>

  <section class="subpage-hero-e subpage-hero-e--left subpage-hero-e--internacional">
    <img
      src="/images/gsn_farma_offices_building3.jpg"
      alt=""
      loading="eager"
    />
    <div class="subpage-hero-e__scrim"></div>
    <div class="subpage-hero-e__inner">
      <h1>Presencia Global</h1>
    </div>
  </section>

  <section class="intl-title">
    <div class="container">
      <div class="intl-title__intro">
        <div class="block2-f__accent-line"></div>
        <h2>GSN FARMA LABS GROUP<br />en el mundo</h2>
        <p>
          Tu partner global en soluciones de salud, con capacidad y presencia para operar en
          mercados de todo el mundo.
        </p>
      </div>
    </div>
  </section>


  <section class="intl-map intl-map--split">
    <div class="container intl-map__split-inner">
      <div class="intl-map__frame">
        <WorldMap showLabels={false} />
      </div>
      <div class="intl-map__list-col">
        <h2>Regiones y países donde operamos</h2>
        <ul class="intl-map__list">
          <li>Europa</li>
          <li>Oriente Medio</li>
          <li>China</li>
          <li>Sudeste Asiático</li>
          <li>Oceanía</li>
          <li>Latinoamérica</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="sp-tag">Prova mòbil · Mapa 1 · Mapa en targeta + xips</div>
  <section class="sp sp-ia1">
    <div class="container sp-stack">
      <h2>Regiones y países donde operamos</h2>
      <span class="sp-bar" aria-hidden="true"></span>
      <div class="sp-mapcard"><WorldMap showLabels={false} /></div>
      <div class="sp-chips">
        {regions.map((r) => <span class="sp-chip">{r}</span>)}
      </div>
    </div>
  </section>

  <div class="sp-tag">Prova mòbil · Mapa 2 · Mapa a sang + fulla</div>
  <section class="sp sp-ia2">
    <div class="sp-ia2__map"><WorldMap showLabels={false} /></div>
    <div class="sp-sheet">
      <h2>Regiones y países donde operamos</h2>
      <span class="sp-bar" aria-hidden="true"></span>
      <ul class="sp-regions">
        {regions.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <div class="sp-tag">Prova mòbil · Mapa 3 · Bloc navy</div>
  <section class="sp sp--navy sp-ia3">
    <div class="container sp-stack">
      <h2>Regiones y países donde operamos</h2>
      <span class="sp-bar" aria-hidden="true"></span>
      <WorldMap showLabels={false} dark />
      <div class="sp-chips">
        {regions.map((r) => <span class="sp-chip">{r}</span>)}
      </div>
    </div>
  </section>

  <section class="intl-catalog">
    <div class="container intl-catalog__inner">
      <div class="block2-f__accent-line"></div>
      <p class="intl-catalog__intro">Catálogo de producto para mercados internacionales:</p>
      <ul class="intl-catalog__list intl-catalog__list--bar intl-catalog__list--bar-download">
        <li>
          <a href="#">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Medicamentos
          </a>
        </li>
        <li>
          <a href="#">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Salud natural
          </a>
        </li>
        <li>
          <a href="#">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Salud animal
          </a>
        </li>
      </ul>
    </div>
  </section>

  <div class="sp-tag">Prova mòbil · Catàleg 1 · Targetes de descàrrega</div>
  <section class="sp sp-ib1">
    <div class="container sp-stack">
      <h2>Catálogo de producto para mercados internacionales:</h2>
      <span class="sp-bar" aria-hidden="true"></span>
      <div class="sp-dl">
        {catalogs.map((c) => (
          <a href="#" class="sp-dlcard">
            <span class="sp-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <span class="sp-dlcard__text">{c}<small>Catálogo internacional</small></span>
            <span class="sp-act__arrow" aria-hidden="true">›</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="sp-tag">Prova mòbil · Catàleg 2 · Botons grans</div>
  <section class="sp sp-ib2">
    <div class="container sp-stack">
      <h2>Catálogo de producto para mercados internacionales:</h2>
      <span class="sp-bar" aria-hidden="true"></span>
      <div class="sp-dl">
        {catalogs.map((c) => (
          <a href="#" class="sp-bigbtn">{c}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        ))}
      </div>
    </div>
  </section>

  <div class="sp-tag">Prova mòbil · Catàleg 3 · Bloc navy amb files</div>
  <section class="sp sp--navy sp-ib3">
    <div class="container sp-stack">
      <h2>Catálogo de producto para mercados internacionales:</h2>
      <span class="sp-bar" aria-hidden="true"></span>
      <div class="sp-dlrows">
        {catalogs.map((c) => (
          <a href="#" class="sp-dlrow">{c}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-alt contact-alt--photo">
    <div class="container">
      <h2>¿Hablamos?</h2>
      <p>
        Contáctanos si estás interesado en explorar oportunidades de colaboración a nivel
        internacional.
      </p>
      <a href="/contacto" class="btn btn--outline-white">Contactar</a>
    </div>
  </section>

  <SpContact
    label="Hablamos"
    title="¿Hablamos?"
    text="Contáctanos si estás interesado en explorar oportunidades de colaboración a nivel internacional."
  />
</BaseLayout>
