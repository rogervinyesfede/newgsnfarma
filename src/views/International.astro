---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorldMap from '../components/WorldMap.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/internacional-body-compare.css';
import '../styles/pages/mobile-hero.css';
import '../styles/pages/desktop-page-header.css';
import '../styles/pages/mobile-proposals.css';
import '../styles/pages/internacional-desktop-proposals.css';
import QdContact from '../components/QdContact.astro';
import CatalogCards from '../components/CatalogCards.astro';
import SpContactBand from '../components/SpContactBand.astro';
import { detectPage, pathFor } from '../i18n/config';
import { ui } from '../i18n/ui';
import { MEDICINES_PDF, ANIMAL_HEALTH_PDF, ESENCIALES_PDF, WOMEN_HEALTH_PDF, NATURAL_HEALTH_PDF } from '../data/documents';
import { international } from '../i18n/international';

// Internacional en els tres idiomes (l'idioma surt de la ruta); els textos són a src/i18n/international.ts.
const { lang } = detectPage(Astro.url.pathname);
const c = international[lang];
const { regions, catalogs } = c;
// Catàlegs amb PDF (per posició: Medicamentos, Los esenciales de la farmacia, Salud natural, Salud de la mujer, Salud animal); s'obren en una pestanya nova, sense popup. Si algun catàleg no en té, l'entrada és null i l'enllaç queda com a '#'.
const catalogPdfs: (string | null)[] = [MEDICINES_PDF, ESENCIALES_PDF, NATURAL_HEALTH_PDF, WOMEN_HEALTH_PDF, ANIMAL_HEALTH_PDF];
const catalogLink = (i: number) => (catalogPdfs[i] ? { href: catalogPdfs[i] as string, target: '_blank', rel: 'noopener noreferrer' } : { href: '#' });
---

<BaseLayout title={c.title} description={c.description}>
  <section class="mhp">
    <div class="mhp__img"><picture>
      <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.webp" type="image/webp" />
      <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.jpg" />
      <img src="/images/gsn_farma_offices_building4.jpg" alt="" loading="eager" fetchpriority="high" />
    </picture></div>
    <div class="mhp__sheet">
      <div class="mhp__title" role="heading" aria-level="1">{c.header.title}</div>
      <span class="mhp__bar" aria-hidden="true"></span>
      <h2 class="mhp__sub">{c.header.sub}</h2>
      <p class="mhp__text">{c.header.text}</p>
    </div>
  </section>

  {/* Capçalera de DESKTOP (>=900px): component compartit (foto amb degradat + fulla amb títol, subtítol, text i, si cal, una ranura). A mòbil s'amaga i el substitueix .mhp. */}

  <section class="qd qd-u qd-u--page">
    <div class="qd-u__photo">
      <picture>
        <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.webp" type="image/webp" />
        <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.jpg" />
        <img src="/images/gsn_farma_offices_building4.jpg" alt="" loading="eager" fetchpriority="high" style="object-position: center 52%" />
      </picture>
    </div>
    <div class="qd-u__sheet">
      <div class="qd-wrap qd-u__grid">
        <div class="qd-u__head">
          <h1>{c.header.title}</h1>
          <span class="qd-bar" aria-hidden="true"></span>
        </div>
        <div class="qd-u__body">
          <h2>{c.header.sub}</h2>
          <p>{c.header.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="intl-map intl-map--split">
    <div class="container intl-map__split-inner">
      <div class="intl-map__frame">
        <WorldMap label={c.mapLabel} />
      </div>
      <div class="intl-map__list-col">
        <h2>{c.regionsTitle}</h2>
        <ul class="intl-map__list">
          {regions.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* Mapa i regions (mòbil <900px): títol, mapa sobre el gris de sempre (a sang) i regions en llista de 2 columnes. S'amaga .intl-map; a desktop és al revés. */}
  <section class="sp sp-ia4">
    <div class="container">
      <div class="sp-head">
        <h2>{c.regionsTitle}</h2>
      </div>
      <div class="sp-ia4__map"><WorldMap label={c.mapLabel} /></div>
      <ul class="sp-regions">
        {regions.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  {/* Catàleg de productes: 5 targetes amb la foto de la marca de cada categoria (desktop: verticals en fila; mòbil: apilades de tot l'ample). Veure CatalogCards.astro. */}
  <CatalogCards title={c.catalogTitle} lang={lang} items={catalogs.map((name, i) => ({ name, href: catalogLink(i).href, external: !!(catalogLink(i) as any).target }))} />

  {/* ¿Hablamos?, versió DESKTOP (>=900px): bloc de contacte compartit (veure QdContact.astro). A mòbil s'amaga i el substitueix SpContactBand. */}
  <QdContact title={c.contact.title} text={c.contact.text} />

  {/* ¿Hablamos?, versió MÒBIL (<900px): banda centrada amb el CTA en enllaç de text (SpContactBand), igual que a Home, Servicios i Nuestras marcas. A desktop s'amaga. */}
  <SpContactBand title={c.contact.title} text={c.contact.textMobile} href={pathFor('contact', lang)} label={ui[lang].contactBand.label} />

</BaseLayout>
