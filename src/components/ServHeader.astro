---
// Capçalera + índex de "Servicios" en MÒBIL (<900px): imatge, fulla blanca amb el títol, la línia blava, el
// subtítol, el text i l'índex de serveis (graella de 2 columnes, gris clar, sense ombres). Acaba en línia recta i la
// Planta de Producción comença just a sota. A mòbil substitueix la capçalera i el bloc d'índex de desktop (que s'hi amaguen).
import '../styles/pages/mobile-hero.css';
import '../styles/pages/mobile-proposals.css';

interface Props {
  title: string;
  sub: string;
  /** HTML (porta un <strong>). */
  text: string;
  navLabel: string;
  items: { t: string; href: string }[];
}

const { title, sub, text, navLabel, items } = Astro.props;
---

<section class="mhp">
  <div class="mhp__img"><picture>
      <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building_hm.webp" type="image/webp" />
      <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building_hm.jpg" />
      <img src="/images/gsn_farma_offices_building.jpg" alt="" loading="eager" fetchpriority="high" />
    </picture></div>
  <div class="mhp__sheet">
    <h1 class="mhp__title">{title}</h1>
    <span class="mhp__bar" aria-hidden="true"></span>
    <h2 class="mhp__sub">{sub}</h2>
    <p class="mhp__text" set:html={text}></p>
    <nav class="sp-gx" aria-label={navLabel}>
      {items.map((it) => <a class="sp-gx__item" href={it.href}>{it.t}</a>)}
    </nav>
  </div>
</section>
