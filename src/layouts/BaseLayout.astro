---
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components/buttons.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { detectPage, alternates, HTML_LANG } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
}

const { title, description = '', noindex = false, transparentHeader = false } = Astro.props;

// Idioma i pàgina segons la ruta (veure src/i18n/config.ts).
const { lang, key } = detectPage(Astro.url.pathname);
const versions = alternates(key);
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {versions.map((v) => <link rel="alternate" hreflang={v.lang} href={v.href} />)}
    {versions.length > 0 && <link rel="alternate" hreflang="x-default" href={versions[0].href} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;700&family=Inter+Tight:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header transparent={transparentHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
