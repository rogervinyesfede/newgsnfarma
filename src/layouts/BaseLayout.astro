---
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components/buttons.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { detectPage, alternates, HTML_LANG, LANGS, SITE } from '../i18n/config';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
}

const { title, description = '', noindex = false, transparentHeader = false } = Astro.props;

// Idioma i pàgina segons la ruta (veure src/i18n/config.ts).
const { lang, key } = detectPage(Astro.url.pathname);
const versions = alternates(key);

// URL canònica i Open Graph (adreces absolutes al domini definitiu, gsnfarma.com)
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = SITE + path;
const OG_LOCALE = { es: 'es_ES', ca: 'ca_ES', en: 'en_GB' } as const;
const ogImage = SITE + '/images/og-gsnfarma.jpg';
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="GSN Farma Labs Group" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content={OG_LOCALE[lang]} />
        {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    {versions.map((v) => <link rel="alternate" hreflang={v.lang} href={v.href} />)}
    {versions.length > 0 && <link rel="alternate" hreflang="x-default" href={versions[0].href} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header transparent={transparentHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
