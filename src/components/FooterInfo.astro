---
import '../styles/components/footer.css';
---

<section class="footer-alt">
  <div class="footer-alt__inner">
    <div class="footer-alt__logo">
      <img src="/images/logo-gsn.svg" alt="GSN Farma Labs Group" />
      <a
        href="https://www.linkedin.com/company/gsn-farma"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-alt__social"
        aria-label="LinkedIn de GSN Farma Labs Group"
      >
        <img src="/images/icon-linkedin.svg" alt="" aria-hidden="true" />
      </a>
    </div>
    <div class="footer-alt__info">
      <div class="footer-alt__col">
        <h3>Información general</h3>
        <p>+34 680 310 655</p>
      </div>
      <div class="footer-alt__col">
        <h3>Farmacovigilancia</h3>
        <p>+34 680 310 655</p>
      </div>
      <div class="footer-alt__col footer-alt__col--address">
        <h3>Oficinas centrales y fábrica</h3>
        <p>C/ del Llobregat 28. 08223.<br />Terrassa (Barcelona)</p>
      </div>
    </div>
  </div>
</section>
