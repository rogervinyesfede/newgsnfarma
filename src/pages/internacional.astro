---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorldMap from '../components/WorldMap.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/components/world-map.css';
import '../styles/pages/internacional-body-compare.css';
import '../styles/pages/mobile-hero.css';
import '../styles/pages/mobile-proposals.css';

// PROVES MÒBIL (.sp)
const regions = ['Europa', 'Oriente Medio', 'China', 'Sudeste Asiático', 'Oceanía', 'Latinoamérica'];
const catalogs = ['Medicamentos', 'Salud natural', 'Salud animal'];
---

<BaseLayout
  title="Internacional | GSN Farma Labs Group"
  description="Presencia internacional de GSN Farma Labs Group."
>
  <section class="mhp">
    <div class="mhp__img"><img src="/images/gsn_farma_offices_building3.jpg" alt="" loading="eager" /></div>
    <div class="mhp__sheet">
      <h1 class="mhp__title">Presencia Global</h1>
      <span class="mhp__bar" aria-hidden="true"></span>
      <h2 class="mhp__sub">GSN FARMA LABS GROUP en el mundo</h2>
      <p class="mhp__text">
        Tu partner global en soluciones de salud, con capacidad y presencia para operar en
        mercados de todo el mundo.
      </p>
    </div>
  </section>

  <section class="subpage-hero-e subpage-hero-e--left subpage-hero-e--internacional">
    <img
      src="/images/gsn_farma_offices_building3.jpg"
      alt=""
      loading="eager"
    />
    <div class="subpage-hero-e__scrim"></div>
    <div class="subpage-hero-e__inner">
      <h1>Presencia Global</h1>
    </div>
  </section>

  <section class="intl-title">
    <div class="container">
      <div class="intl-title__intro">
        <div class="block2-f__accent-line"></div>
        <h2>GSN FARMA LABS GROUP<br />en el mundo</h2>
        <p>
          Tu partner global en soluciones de salud, con capacidad y presencia para operar en
          mercados de todo el mundo.
        </p>
      </div>
    </div>
  </section>


  <section class="intl-map intl-map--split">
    <div class="container intl-map__split-inner">
      <div class="intl-map__frame">
        <WorldMap showLabels={false} />
      </div>
      <div class="intl-map__list-col">
        <h2>Regiones y países donde operamos</h2>
        <ul class="intl-map__list">
          <li>Europa</li>
          <li>Oriente Medio</li>
          <li>China</li>
          <li>Sudeste Asiático</li>
          <li>Oceanía</li>
          <li>Latinoamérica</li>
        </ul>
      </div>
    </div>
  </section>

  {/* Mapa i regions (mòbil <900px): títol, mapa sobre el gris de sempre (a sang) i regions en llista de 2 columnes. S'amaga .intl-map; a desktop és al revés. */}
  <section class="sp sp-ia4">
    <div class="container">
      <div class="sp-head">
        <h2>Regiones y países donde operamos</h2>
      </div>
      <div class="sp-ia4__map"><WorldMap showLabels={false} /></div>
      <ul class="sp-regions">
        {regions.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <section class="intl-catalog intl-catalog--desktop">
    <div class="container intl-catalog__inner">
      <div class="block2-f__accent-line"></div>
      <p class="intl-catalog__intro">Catálogo de productos para mercados internacionales:</p>
      <ul class="intl-catalog__list intl-catalog__list--bar intl-catalog__list--bar-download">
        <li>
          <a href="#">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Medicamentos
          </a>
        </li>
        <li>
          <a href="#">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Salud natural
          </a>
        </li>
        <li>
          <a href="#">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Salud animal
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="contact-alt contact-alt--photo intl-contact">
    <div class="container">
      <h2>¿Hablamos?</h2>
      <p>
        Contáctanos si estás interesado en explorar oportunidades de colaboración a nivel
        internacional.
      </p>
      <a href="/contacto" class="btn btn--outline-white">Contactar</a>
    </div>
  </section>

  {/* Catàleg de producto (mòbil <900px): títol (24/700 amb línia blava, com els títols de bloc de Quiénes somos) i els tres enllaços de descàrrega en files amb filets, alineats a l'esquerra. S'amaga .intl-catalog; a desktop és al revés. */}
  <section class="sp sp-ic2">
    <div class="container">
      <div class="sp-head">
        <h2>Catálogo de productos para mercados internacionales:</h2>
        <span class="sp-bar" aria-hidden="true"></span>
      </div>
      <div class="sp-ic2__rows">
        {catalogs.map((c) => (
          <a href="#" class="sp-ic2__row"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{c}</span></a>
        ))}
      </div>
    </div>
  </section>

  {/* ¿Hablamos?: mateix bloc que a Servicios (foto + enllaç), independent i amb marges rectes. A mòbil (<900px) es veu aquesta peça i s'amaga .intl-contact; a desktop és al revés. */}
  <section class="sp sp--navy sp-ct2">
    <div class="sp-ct2__bg" aria-hidden="true"></div>
    <div class="sp-ct2__body">
      <h2>¿Hablamos?</h2>
      <p>Contáctanos si estás interesado en explorar oportunidades de colaboración a nivel internacional.</p>
      <a href="/contacto" class="sp-link">Contactar<span aria-hidden="true">›</span></a>
    </div>
  </section>
</BaseLayout>
