---
// Capçalera de MÒBIL (<900px) de Quiénes somos, definitiva: foto de 220px (sense degradat) i fulla blanca arrodonida que li puja 32px, amb el títol («Grupo farmacéutico con más de 30 años…», 24/700), la barra cian a sota i el paràgraf (17/400), tot alineat a l'esquerra. El títol és l'H1 de la pàgina (ja no hi ha cap H1 ocult amb «Sumamos experiencia, sumamos salud»).
// A desktop s'amaga i es veu PageHeader.astro. Estils: quienes-somos-header-mobile.css.
import '../styles/pages/quienes-somos-header-mobile.css';
import { about } from '../i18n/about';

interface Props {
  lang: 'es' | 'ca' | 'en';
}
const { lang } = Astro.props;
const c = about[lang];
const { h2, p } = c.intro;
---

<section class="qs-mph">
  <div class="qs-mph__img">
    <picture>
      <source srcset="/images/gsn_farma_offices_building3_hm.webp" type="image/webp" />
      <source srcset="/images/gsn_farma_offices_building3_hm.jpg" />
      <img src="/images/gsn_farma_offices_building3_hm.jpg" alt="" loading="eager" fetchpriority="high" />
    </picture>
  </div>
  <div class="qs-mph__sheet">
    <h1 class="qs-mph__title">{h2}</h1>
    <span class="qs-mph__bar" aria-hidden="true"></span>
    <p class="qs-mph__text">{p}</p>
  </div>
</section>
