---
import '../styles/components/hero.css';

interface Props {
  title: string;
  pretitle?: string;
  subtitle?: string;
  image?: string;
  imageMobile?: string;
  /** Vídeo de fons opcional (només per a `split=false`). `image` s'utilitza com a poster. */
  video?: string;
  /** Variant vertical/optimitzada del vídeo, servida per sota de 768px. */
  videoMobile?: string;
  /** El text ja va imprès a la imatge (banner d'inici real): el títol
   * es manté per accessibilitat però visualment amagat. Només per a `split=false`. */
  textInImage?: boolean;
  /** Patró real de les pàgines internes: columna de text (fons fosc) + imatge. */
  split?: boolean;
  /** El hero arriba fins dalt de tot i el header (transparent) queda superposat. Només a la home. */
  overlapHeader?: boolean;
  /** CTA opcional centrat a sota del claim (patró vídeo, a l'estil Orissens). Només per a `video`. */
  ctaLabel?: string;
  ctaHref?: string;
  /** Títol i subtítol una mica més grans. Només per a `video`. */
  largeText?: boolean;
  /** CTA amb vora blanca i sense fons, en lloc del cian. Només per a `video`. */
  ctaOutline?: boolean;
}

const {
  title,
  pretitle,
  subtitle,
  image,
  imageMobile,
  video,
  videoMobile,
  textInImage = false,
  split = false,
  overlapHeader = false,
  ctaLabel,
  ctaHref,
  largeText = false,
  ctaOutline = false,
} = Astro.props;
const style = [
  image ? `--hero-image: url(${image})` : '',
  imageMobile ? `--hero-image-mobile: url(${imageMobile})` : '',
]
  .filter(Boolean)
  .join('; ');
---

{split ? (
  <section class="hero-split">
    <div class="hero-split__text">
      {pretitle && <span class="hero-split__pretitle">{pretitle}</span>}
      <h1>{title}</h1>
    </div>
    <div class="hero-split__image">
      {image && <img src={image} alt="" loading="eager" />}
    </div>
  </section>
) : (
  <section class={`hero${overlapHeader ? ' hero--overlap' : ''}`} style={style || undefined}>
    {video && (
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={image}
        aria-hidden="true"
        data-src-desktop={video}
        data-src-mobile={videoMobile || video}
      ></video>
    )}
    {video && <div class="hero__fade-top" aria-hidden="true"></div>}
    {!textInImage && <div class="hero__overlay"></div>}
    <div class={`hero__content${video ? ' hero__content--video' : ''}${video && largeText ? ' hero__content--lg' : ''}`}>
      <h1 class={textInImage ? 'sr-only' : undefined}>{title}</h1>
      {subtitle && <p class={textInImage ? 'sr-only' : undefined}>{subtitle}</p>}
      {video && ctaLabel && ctaHref && (
        <a href={ctaHref} class={`btn${ctaOutline ? ' btn--outline-white' : ''}`}>{ctaLabel}</a>
      )}
    </div>
  </section>
)}

{video && (
  <script>
    // El navegador ignora sovint l'atribut `media` a <source> dins <video>
    // (a diferència de <picture>), així que triem la font per JS: evita
    // que es descarreguin totes dues i garanteix que el mòbil rep sempre
    // la variant lleugera.
    document.querySelectorAll('.hero__video[data-src-desktop]').forEach((el) => {
      // iOS/Safari només deixa l'autoplay si el vídeo és mut com a PROPIETAT (no
      // només com a atribut) i va inline; si no, mostra el botó de play al mig.
      el.muted = true;
      el.defaultMuted = true;
      el.playsInline = true;
      el.setAttribute('webkit-playsinline', '');

      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      const src = isMobile ? el.dataset.srcMobile : el.dataset.srcDesktop;
      const tryPlay = () => {
        if (!el.paused) return;
        const p = el.play();
        if (p && p.catch) p.catch(() => {});
      };

      if (src && el.getAttribute('src') !== src) {
        el.src = src;
        el.load();
      }
      tryPlay();
      el.addEventListener('loadeddata', tryPlay);
      el.addEventListener('canplay', tryPlay);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) tryPlay();
      });
      // El mode d'estalvi d'energia d'iOS bloqueja l'autoplay: es reintenta amb el
      // primer gest de l'usuari (tocar la pantalla).
      ['touchend', 'pointerdown', 'click'].forEach((ev) =>
        window.addEventListener(ev, tryPlay, { once: true, passive: true })
      );
    });
  </script>
)}
