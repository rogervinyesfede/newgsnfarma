---
import BaseLayout from '../layouts/BaseLayout.astro';
import services from '../data/services.json';
import '../styles/pages/inner-page.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/servicios-body-compare.css';
import '../styles/pages/mobile-hero.css';
import '../styles/pages/mobile-proposals.css';
import SpPlanta from '../components/SpPlanta.astro';
import ServHeader from '../components/ServHeader.astro';

const serviceImages: Record<string, string> = {
  'Almacenamiento farmacéutico': '/images/servicios-almacenamiento.jpg',
  'Aseguramiento de la calidad': '/images/gsn_farma_Aseguramiento_de_la_calidad.jpg',
  'Acondicionamiento secundario y serialización': '/images/gsn_farma_acondicionamiento.jpg',
  'Cámaras climáticas y estudios de estabilidad': '/images/gsn_farma_camaras.jpg',
  'Asuntos regulatorios': '/images/servicios-regulatory.webp',
  'Subvenciones': '/images/servicios-subvenciones.webp',
};

// Capacidad productiva: dades del bloc (icona, tipus d'envàs i unitats anuals).
const capacityItems = [
  { title: 'Comprimidos', value: '22.000.000', icon: '<circle cx="12" cy="12" r="8"></circle>' },
  { title: 'Cápsulas', value: '22.000.000', icon: '<rect x="4" y="9" width="16" height="6" rx="3"></rect><path d="M12 9v6" stroke-linecap="round"></path>' },
  { title: 'Botes pildoreros', value: '660.000', icon: '<path d="M9 3h6v3.5l2 3V21H7V9.5l2-3V3z" stroke-linecap="round" stroke-linejoin="round"></path><path d="M7 13h10" stroke-linecap="round"></path>' },
  { title: 'Doypacks', value: '350.000', icon: '<path d="M6 8c0-2.5 2-4.5 6-4.5s6 2 6 4.5v11a2 2 0 01-2 2H8a2 2 0 01-2-2V8z" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9 3.5v3M15 3.5v3" stroke-linecap="round"></path>' },
  { title: 'Blísteres', value: '2.200.000', icon: '<rect x="3" y="4" width="18" height="16" rx="1"></rect><path d="M3 10h18M9 4v16M15 4v16"></path>' },
  { title: 'Estuches de blísteres', value: '700.000', icon: '<path d="M3 8l9-5 9 5-9 5-9-5z" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 8v8l9 5 9-5V8" stroke-linecap="round" stroke-linejoin="round"></path>' },
];

// Versions de les imatges de les franges per a mòbil (<768px, 1200x500, proporció 2,4:1).
const serviceImagesMobile: Record<string, string> = {
  'Almacenamiento farmacéutico': '/images/servicios-almacenamiento_mb.jpg',
  'Aseguramiento de la calidad': '/images/gsn_farma_Aseguramiento_de_la_calidad_mb.jpg',
  'Acondicionamiento secundario y serialización': '/images/gsn_farma_acondicionamiento_mb.jpg',
  'Cámaras climáticas y estudios de estabilidad': '/images/gsn_farma_camaras_mb.jpg',
  'Asuntos regulatorios': '/images/servicios-regulatory_mb.jpg',
  'Subvenciones': '/images/servicios-subvenciones_mb.jpg',
};

// Dades per a les PROVES MÒBIL (.sp): mateix contingut que els blocs actuals.
const lab = {
  title: 'Laboratorio',
  img: '/images/gsn_farma_lab_mb.jpg',
  alt: 'Laboratorio de I+D de GSN Farma',
  p1: 'En el área de I+D combinamos los servicios globales de desarrollo de CoetusPharma con los servicios de desarrollo de producto de GSN Farma, cubriendo tanto I+D galénico (medicamentos y formas farmacéuticas nuevas) como I+D nutricional (complementos alimenticios y productos funcionales).',
  p2: 'Acompañamos proyectos propios y de terceros desde la fase conceptual hasta su escalado industrial, con planta piloto, ensayos de estabilidad y soporte técnico específico, ofreciendo un enfoque integral, flexible y orientado a resultados.',
};

const serviceIds: Record<string, string> = {
  'Almacenamiento farmacéutico': 'almacenamiento',
  'Aseguramiento de la calidad': 'calidad',
  'Acondicionamiento secundario y serialización': 'acondicionamiento',
  'Cámaras climáticas y estudios de estabilidad': 'camaras-climaticas',
  'Asuntos regulatorios': 'regulatorio',
  'Subvenciones': 'subvenciones',
};
---

<BaseLayout
  title="Servicios farmacéuticos | GSN Farma Labs Group"
  description="Servicios farmacéuticos especializados en desarrollo, fabricación y gestión de productos farmacéuticos y soluciones de salud con altos estándares de calidad."
>
  {/* Capçalera + índex (mòbil): graella plana; la fulla passa per sobre de la foto de la Planta. */}
  <ServHeader />

  {/* Capçalera i índex de DESKTOP (a mòbil s'amaguen; veure mobile-hero.css) */}
  <section class="subpage-hero-e subpage-hero-e--left subpage-hero-e--servicios">
    <img
      src="/images/gsn_farma_offices_building.jpg"
      alt=""
      loading="eager"
      style="object-position: center 40%"
    />
    <div class="subpage-hero-e__scrim"></div>
    <div class="subpage-hero-e__inner">
      <h1>Servicios Farmacéuticos</h1>
    </div>
  </section>

  <section class="srv-union">
    <div class="container">
      <div class="srv-union__intro">
        <div class="block2-f__accent-line"></div>
        <h2>Tu partner global en<br />soluciones de salud</h2>
        <p>
          <strong>17.000 m²</strong> dedicados a desarrollo, fabricación, análisis y
          almacenamiento.
        </p>
      </div>
      <div class="srv-union__grid">
        <a href="#fabricacion" class="srv-union__item">Fabricación</a>
        <a href="#i-d" class="srv-union__item">I+D</a>
        <a href="#almacenamiento" class="srv-union__item">Almacenamiento</a>
        <a href="#calidad" class="srv-union__item">Aseguramiento de calidad</a>
        <a href="#regulatorio" class="srv-union__item">Asuntos regulatorios</a>
        <a href="#camaras-climaticas" class="srv-union__item">Cámaras climáticas y estudios de estabilidad</a>
        <a href="#acondicionamiento" class="srv-union__item">Acondicionamiento secundario y serialización</a>
        <a href="#subvenciones" class="srv-union__item">Subvenciones</a>
      </div>
    </div>
  </section>

  {/* Planta de Producción + Capacidad productiva: a mòbil (<900px) es veu aquesta peça (foto + fulla amb la
       capacitat a dins) i s'amaguen #fabricacion i .srv-capacity; a desktop és al revés. */}
  <SpPlanta id="fabricacion-m">
    <div class="sp-panel">
      <h2 class="sp-panel__title">Capacidad productiva:</h2>
      <ul class="sp-rows">
        {capacityItems.map((item) => (
          <li>
            <span class="sp-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={item.icon}></svg></span>
            <span class="sp-rows__name">{item.title}<small>uds./año</small></span>
            <strong>{item.value}</strong>
          </li>
        ))}
      </ul>
    </div>
  </SpPlanta>

  {/* Laboratorio: a mòbil (<900px) es veu aquesta peça (foto + fulla navy) i s'amaga #i-d; a desktop és al revés.
       La fulla de Planta li passa per sobre (28px), com "Una unión…" sobre One Health a Quiénes somos. */}
  <section class="sp sp--navy sp-lab" id="i-d-m">
    <div class="sp-photo">
      <img src={lab.img} alt={lab.alt} loading="lazy" />
      <div class="sp-photo__over">
        <h2>{lab.title}</h2>
        <span class="sp-bar" aria-hidden="true"></span>
      </div>
    </div>
    <div class="sp-sheet sp-sheet--navy">
      <p>{lab.p1}</p>
      <p>{lab.p2}</p>
    </div>
  </section>

  {/* Servicios especializados: a mòbil (<900px) es veu aquest acordió i s'amaguen .srv-others i les franges .srv-strip;
       a desktop és al revés. Li passa per sota la fulla navy del Laboratorio (28px). */}
  <section class="sp sp-tuck2 sp-es1">
    <div class="container">
      <div class="sp-head">
        <h2>Servicios especializados:</h2>
        <span class="sp-bar" aria-hidden="true"></span>
      </div>
      <div class="sp-acc">
        {services.map((service, i) => (
          <details id={`${serviceIds[service.title]}-m`} open={i === 0}>
            <summary>
              <span class="sp-acc__thumb"><img src={serviceImagesMobile[service.title]} alt="" loading="lazy" /></span>
              <span class="sp-acc__title">{service.title}</span>
              <span class="sp-acc__chev" aria-hidden="true"></span>
            </summary>
            <div class="sp-acc__body">
              <img src={serviceImagesMobile[service.title]} alt="" loading="lazy" />
              {service.description.split('\n').map((line: string) => <p set:html={line} />)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="fabricacion" class="block2-f block3-d__row--50-50 block3-d__row--onehealth srv-fi--white">
    <div class="container">
      <div class="block2-f__image">
        <picture>
          <source media="(max-width: 899px)" srcset="/images/gsn_farma_factory_mb.jpg" />
          <img src="/images/gsn_farma_factory.jpg" alt="Planta de producción de GSN Farma" loading="lazy" />
        </picture>
      </div>
      <div class="block2-f__text">
        <div class="block2-f__accent-line"></div>
        <h2>Planta de Producción</h2>
        <p>
          Fabricación de complementos alimenticios en formas sólidas (comprimidos, cápsulas y
          doypacks) bajo los más altos estándares de calidad, seguridad y trazabilidad, conforme
          a normativa GMP e IFS Food Supplements.
        </p>
        <p>
          Ofrecemos un servicio integral y flexible, con desarrollos a medida y formatos
          adaptados a tu marca, desde el desarrollo hasta el producto final.
        </p>
      </div>
    </div>
  </section>

  <section class="srv-capacity">
    <div class="container">
      <h2>Capacidad productiva:</h2>
      <div class="srv-capacity__grid">
        {capacityItems.map((item) => (
          <div class="srv-capacity__item">
            <span class="srv-capacity__icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={item.icon}></svg>
            </span>
            <h3>{item.title}</h3>
            <strong>{item.value}</strong>
            <span class="srv-capacity__unit">uds./año</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="i-d" class="block2-f block3-d__row--50-50 block3-d__row--onehealth srv-fi--navy">
    <div class="container">
      <div class="block2-f__text">
        <div class="block2-f__accent-line"></div>
        <h2>Laboratorio</h2>
        <p>
          En el área de I+D combinamos los servicios globales de desarrollo de CoetusPharma con
          los servicios de desarrollo de producto de GSN Farma, cubriendo tanto I+D galénico
          (medicamentos y formas farmacéuticas nuevas) como I+D nutricional (complementos
          alimenticios y productos funcionales).
        </p>
        <p>
          Acompañamos proyectos propios y de terceros desde la fase conceptual hasta su escalado
          industrial, con planta piloto, ensayos de estabilidad y soporte técnico específico,
          ofreciendo un enfoque integral, flexible y orientado a resultados.
        </p>
      </div>
      <div class="block2-f__image">
        <picture>
          <source media="(max-width: 899px)" srcset="/images/gsn_farma_lab_mb.jpg" />
          <img src="/images/gsn_farma_lab.jpg" alt="Laboratorio de I+D de GSN Farma" loading="lazy" />
        </picture>
      </div>
    </div>
  </section>

  <section class="srv-others">
    <div class="container">
      <div class="block2-f__text">
        <div class="block2-f__accent-line"></div>
        <h2>Servicios especializados:</h2>
      </div>
    </div>
  </section>

  {services.map((service, i) => (
    <section id={serviceIds[service.title]} class={`content-section content-section--split srv-strip ${i % 2 === 1 ? 'srv-strip--grey' : ''}`}>
      <div class="container content-section__split-inner">
        {i % 2 === 0 ? (
          <>
            <div class={`content-section__image srv-strip__image${serviceImagesMobile[service.title] ? ' srv-strip__image--mb' : ''}`}>
              <picture>
                {serviceImagesMobile[service.title] && <source media="(max-width: 767px)" srcset={serviceImagesMobile[service.title]} />}
                <img src={serviceImages[service.title]} alt="" loading="lazy" />
              </picture>
            </div>
            <div class="content-section__text">
              <h3>{service.title}</h3>
              {service.description.split('\n').map((line: string) => <p set:html={line} />)}
            </div>
          </>
        ) : (
          <>
            <div class="content-section__text">
              <h3>{service.title}</h3>
              {service.description.split('\n').map((line: string) => <p set:html={line} />)}
            </div>
            <div class={`content-section__image srv-strip__image${serviceImagesMobile[service.title] ? ' srv-strip__image--mb' : ''}`}>
              <picture>
                {serviceImagesMobile[service.title] && <source media="(max-width: 767px)" srcset={serviceImagesMobile[service.title]} />}
                <img src={serviceImages[service.title]} alt="" loading="lazy" />
              </picture>
            </div>
          </>
        )}
      </div>
    </section>
  ))}

  <section class="contact-alt contact-alt--photo srv-contact">
    <div class="container">
      <h2>¿Quieres saber más?</h2>
      <p>
        Contáctanos para recibir más información sobre nuestros servicios.
      </p>
      <a href="/contacto" class="btn btn--outline-white">Contactar</a>
    </div>
  </section>

  {/* ¿Quieres saber más?: a mòbil (<900px) es veu aquesta peça (foto + enllaç) i s'amaga .srv-contact; a desktop és al revés.
       Puja 28px per sobre de l'acordió i el footer li passa per sota (28px), només en aquesta pàgina. */}
  <section class="sp sp--navy sp-ct2 sp-ct2--final">
    <div class="sp-ct2__bg" aria-hidden="true"></div>
    <div class="sp-ct2__body">
      <h2>¿Quieres saber más?</h2>
      <p>Contáctanos para recibir más información sobre nuestros servicios.</p>
      <a href="/contacto" class="sp-link">Contactar<span aria-hidden="true">›</span></a>
    </div>
  </section>

  <script>
    // Índex de serveis a mòbil: si l'enllaç apunta a un ítem de l'acordió, l'obre i hi va.
    const openFromHash = () => {
      const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (el && el.tagName === 'DETAILS') {
        (el as HTMLDetailsElement).open = true;
        el.scrollIntoView();
      }
    };
    window.addEventListener('hashchange', openFromHash);
    openFromHash();
  </script>
</BaseLayout>
