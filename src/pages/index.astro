---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/home-body-compare.css';
import '../styles/pages/mobile-proposals.css';
import '../styles/pages/desktop-page-header.css';
import '../styles/pages/home-desktop-proposals.css';
import QdContact from '../components/QdContact.astro';

// PROVES MÒBIL (.sp): mateix contingut que els blocs actuals.
const oh = {
  p1: 'Adoptamos el modelo One Health como visión transversal: una salud integrada, sostenible y conectada entre personas, animales y entorno.',
  p2: 'Desarrollamos, fabricamos y comercializamos productos regulados con agilidad y rigor técnico, bajo los más altos estándares de calidad.',
};
const areas = [
  {
    title: 'Servicios Farmacéuticos',
    img: '/images/services_mb.jpg',
    alt: 'Científica trabajando con microscopio en el laboratorio',
    text: 'Unidad industrial con 17.000 m² para ofrecer servicios integrales en desarrollo, fabricación, aseguramiento de calidad, asuntos regulatorios y logística para productos regulados.',
    href: '/servicios',
    cta: 'Ver todos los servicios',
  },
  {
    title: 'Marcas Propias',
    img: '/images/brands_home_products_mb.jpg',
    alt: 'Mano sosteniendo iconos de productos de salud, representando el portafolio de marcas propias',
    text: 'Desarrollamos y comercializamos un portafolio de salud transversal, con medicamentos y productos de salud humana y animal, impulsados por la innovación y el rigor farmacéutico.',
    href: '/nuestras-marcas',
    cta: 'Ver todas las marcas',
  },
];
// "Así sumamos salud" (mòbil): mateix bloc i mateixes fotos que Quiénes somos, amb els textos i CTA de la Home.
const masIntro = 'Estructuramos nuestra actividad en dos grandes áreas de negocio: los <strong>servicios farmacéuticos</strong> y las <strong>marcas propias</strong>.';
// Mateixa frase en dues línies, com a Quiénes somos (desktop).
const areasIntro2 = 'Estructuramos nuestra actividad en dos grandes áreas de negocio:<br />los <strong>servicios farmacéuticos</strong> y las <strong>marcas propias</strong>.';
const masAreas = [
  { ...areas[0], img: '/images/about_services.jpg', imgMb: '/images/about_services_mb.jpg', muted: 'block2-f__image--muted' },
  { ...areas[1], img: '/images/about_brands.jpg', imgMb: '/images/about_brands_mb.jpg', muted: 'block2-f__image--muted block2-f__image--muted-strong' },
];
const funding = [
  {
    intro: 'Subvenciones a proyectos singulares de la economía social y solidaria y el cooperativismo:',
    logos: [
      ['/images/economia_social_logo.png', 'Economía Social'],
      ['/images/gencat_empresa_treball-logo.png', "Generalitat de Catalunya — Departament d'Empresa i Treball"],
      ['/images/ministerio_logo.png', 'Ministerio de Trabajo y Economía Social — SEPE'],
    ],
  },
  {
    intro: 'Proyecto Estratégico para la Recuperación y Transformación Económica Agroalimentario:',
    logos: [
      ['/images/nextgeneration_logo.png', 'Financiado por la Unión Europea — NextGenerationEU'],
      ['/images/perte_agro_logo.jpg', 'Plan de Recuperación, Transformación y Resiliencia'],
      ['/images/ministerio_industria_logo.png', 'Ministerio de Industria y Turismo'],
    ],
  },
];

// Àrees de negoci de desktop: fotos verticals dels panells.
const homeAreas = [
  { ...areas[0], panel: '/images/about_services_mb.jpg' },
  { ...areas[1], panel: '/images/about_brands_mb.jpg' },
];
const ohCta = 'Conoce más sobre el grupo';
---

<BaseLayout
  title="GSN Farma Labs Group | Laboratorio farmacéutico"
  description="Laboratorio farmacéutico con más de 30 años de experiencia desarrollando soluciones de salud con visión global y ADN farmacéutico bajo el enfoque One Health Care."
>
  <Hero
    title="Un nuevo grupo farmacéutico"
    subtitle="Más de 30 años de experiencia y visión global en salud"
    image="/images/hero-video-frame.jpg"
    imageMobile="/images/hero-video-frame.jpg"
    video="/videos/video_gsn_farma.mp4"
    videoMobile="/videos/video_gsn_farma_mobile.mp4"
    overlapHeader
    ctaLabel="Conócenos"
    ctaHref="/quienes-somos"
    largeText
    ctaOutline
    mobileOnly
  />

  {/* Hero de DESKTOP (>=900px): vídeo amb el text centrat a baix i el CTA en píndola. A mòbil s'amaga i es veu el <Hero> de dalt (només mòbil). */}
  <section class="qd qd-hh">
    <video class="qd-hh__video" muted loop playsinline preload="none" poster="/images/hero-video-frame.jpg" aria-hidden="true" data-src="/videos/video_gsn_farma.mp4"></video>
    <div class="qd-hh__fade" aria-hidden="true"></div>
    <div class="qd-hh__shade" aria-hidden="true"></div>
    <div class="qd-hh__content">
      <h1 class="qd-hh__title">Un nuevo grupo farmacéutico</h1>
      <p class="qd-hh__sub">Más de 30 años de experiencia y visión global en salud</p>
      <a href="/quienes-somos" class="qd-ct__btn">Conócenos<span aria-hidden="true">›</span></a>
    </div>
  </section>
  <script is:inline>
    (function () {
      // Només es descarrega el vídeo a desktop (a mòbil aquest bloc està amagat): s'inicia quan l'ample arriba a 900px.
      var mq = window.matchMedia('(min-width: 900px)');
      var started = false;
      function start() {
        if (started || !mq.matches) return;
        var v = document.querySelector('.qd-hh__video');
        if (!v) return;
        started = true;
        v.muted = true;
        v.src = v.getAttribute('data-src');
        v.load();
        var play = function () {
          if (!v.paused) return;
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        };
        play();
        v.addEventListener('canplay', play);
      }
      start();
      window.addEventListener('load', start);
      if (mq.addEventListener) mq.addEventListener('change', start);
    })();
  </script>





  {/* One Health, versió DESKTOP (>=900px): foto arrodonida a l'esquerra i text a la dreta, sobre gris. A mòbil s'amaga i el substitueix .sp-oh. */}
  <section class="qd qd-ho">
    <div class="qd-wrap qd-ho__grid">
      <div class="qd-ho__photo"><img src="/images/one_health_gsnfarma4.jpg" alt="Familia con su mascota en casa y manos sosteniendo una planta, símbolo del enfoque One Health" loading="lazy" /></div>
      <div class="qd-ho__text">
        <h2>One Health:<br />el propósito que nos guía</h2>
        <span class="qd-bar" aria-hidden="true"></span>
        <p>{oh.p1}</p>
        <p>{oh.p2}</p>
        <a href="/quienes-somos" class="qd-cta">{ohCta}<span aria-hidden="true">›</span></a>
      </div>
    </div>
  </section>

  {/* One Health (mòbil <900px): fulla blanca (cantonades de 28px) que puja 28px sobre el vídeo del hero, amb el títol, la línia cian, la foto en targeta i els textos i el CTA de la Home. A desktop s'amaga i es veu .qd-ho. */}
  <section class="sp sp-oh">
    <h2>One Health:<br />el propósito que nos guía</h2>
    <span class="sp-bar" aria-hidden="true"></span>
    <img class="sp-oh__img" src="/images/one_health_gsnfarma4.jpg" alt="Familia con su mascota en casa y manos sosteniendo una planta, símbolo del enfoque One Health" loading="lazy" />
    <p class="sp-oh__lead">{oh.p1}</p>
    <p>{oh.p2}</p>
    <a href="/quienes-somos" class="sp-cta">Conoce más sobre el grupo<span aria-hidden="true">›</span></a>
  </section>

  {/* Àrees de negoci, versió DESKTOP (>=900px): bloc navy amb «Así sumamos salud» i dos panells de foto (Servicios Farmacéuticos i Marcas Propias), com a Quiénes somos. A mòbil s'amaga i el substitueix .sp-hm. */}
  <section class="qd qd-navy qd-ha">
    <div class="qd-wrap">
      <div class="qd-ha__head">
        <span class="qd-bar" aria-hidden="true"></span>
        <h2>Así sumamos salud</h2>
        <p set:html={areasIntro2}></p>
      </div>
      <div class="qd-ha__panels">
        {homeAreas.map((a) => (
          <a class="qd-ha__panel" href={a.href}>
            <img src={a.panel} alt={a.alt} loading="lazy" />
            <div class="qd-ha__body">
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="qd-cta">{a.cta}<span aria-hidden="true">›</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Àrees de negoci (mòbil <900px): com a «Así sumamos salud» de Quiénes somos (bloc gris, introducció i dues targetes immersives, mateixes fotos), amb els textos i CTA de la Home. A desktop s'amaga i es veu .qd-ha. */}
  <section class="sp sp-hm">
    <div class="container sp-hm__intro">
      <h2>Así sumamos salud</h2>
      <span class="sp-hm__bar" aria-hidden="true"></span>
      <p set:html={masIntro}></p>
    </div>
    <div class="container sp-hm__cards">
      {masAreas.map((a) => (
        <a class="sp-hm__card" href={a.href}>
          <span class={`sp-hm__img ${a.muted}`}>
            <picture>
              <source media="(max-width: 767px)" srcset={a.imgMb} />
              <img src={a.img} alt={a.alt} loading="lazy" />
            </picture>
          </span>
          <span class="sp-hm__body">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <span class="sp-hm__link">{a.cta}<span class="sp-hm__link-arrow" aria-hidden="true">›</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* Finançament, versió DESKTOP (>=900px): rètol centrat i dues columnes amb el seu text i els logos (als colors originals: requisit de publicitat de la UE). A desktop va entre Àrees i el contacte (franja blanca que separa els dos blocs navy). A mòbil s'amaga i el substitueix .sp-fa. */}
  <section class="qd qd-hf">
    <div class="qd-wrap">
      <p class="qd-hf__caption">Con la colaboración de:</p>
      <div class="qd-hf__cols">
        {funding.map((g) => (
          <div class="qd-hf__col">
            <p>{g.intro}</p>
            <div class="qd-hf__logos">
              {g.logos.map(([src, alt]) => <img src={src} alt={alt} loading="lazy" />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ¿Hablamos?, versió DESKTOP (>=900px): bloc de contacte compartit (veure QdContact.astro). A mòbil s'amaga i el substitueix .sp-ct2. */}
  <QdContact title="¿Hablamos?" text="En GSN Farma Labs Group trabajamos como partner estratégico para impulsar soluciones en salud con visión a largo plazo." />


  {/* ¿Hablamos?, versió MÒBIL (<900px): mateixa peça que a Servicios i Internacional (foto + enllaç); a desktop s'amaga. */}
  <section class="sp sp--navy sp-ct2">
    <div class="sp-ct2__bg" aria-hidden="true"></div>
    <div class="sp-ct2__body">
      <h2>¿Hablamos?</h2>
      <p>En GSN Farma Labs Group trabajamos como partner estratégico para impulsar soluciones en salud con visión a largo plazo.</p>
      <a href="/contacto" class="sp-link">Contactar<span aria-hidden="true">›</span></a>
    </div>
  </section>


  {/* Finançament (mòbil <900px): franja de mínima importància — rètol petit, textos de 13px en gris i logos de 24px als seus colors originals (no es modifiquen per requisits de publicitat de la UE). A desktop s'amaga i es veu .qd-hf. */}
  <section class="sp sp-fa">
    <div class="container">
      <p class="sp-fcap">Con la colaboración de:</p>
      {funding.map((g) => (
        <div class="sp-fa__group">
          <p>{g.intro}</p>
          <div class="sp-fa__logos">
            {g.logos.map(([src, alt]) => <img src={src} alt={alt} loading="lazy" />)}
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
