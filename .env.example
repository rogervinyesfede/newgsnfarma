# Variables del formulari de contacte (api/contact.js). Es configuren a Vercel > Settings > Environment Variables.
# NO posar mai els valors reals en aquest fitxer ni al repositori.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Opcionals
MAIL_FROM=
MAIL_TO=info@gsnfarma.com

# Identificador de Google Tag Manager (analítica). Sense valor: la web no té cookies opcionals i el bàner no es mostra.
# GTM-XXXXXXX = marcador de posició (es veu el bàner però no es carrega res). Un identificador real: l'analítica es carrega només si l'usuari l'accepta.
PUBLIC_GTM_ID=
