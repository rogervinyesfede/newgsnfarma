        <a class="sp-nrow" href="tel:+34680310655"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="sp-nrow__text"><small>Información general</small>+34 680 310 655</span></a>
        <a class="sp-nrow" href="tel:+34680310655"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="sp-nrow__text"><small>Farmacovigilancia</small>+34 680 310 655</span></a>
        <a class="sp-nrow" href="mailto:info@gsnfarma.com"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="sp-nrow__text"><small>Correo electrónico</small>info@gsnfarma.com</span></a>
