---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/block2.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/quienes-somos-body-compare.css';
import '../styles/pages/desktop-page-header.css';
import '../styles/pages/quienes-somos-desktop-proposals.css';
import { detectPage, pathFor } from '../i18n/config';
import { about } from '../i18n/about';

// Quiénes somos en els tres idiomes (l'idioma surt de la ruta); els textos són a src/i18n/about.ts.
// Dades dels blocs de mòbil (.qs-m*). Els blocs de desktop porten el seu text directament al marcat.
const { lang } = detectPage(Astro.url.pathname);
const c = about[lang];
const areaMeta = [
  { img: '/images/about_services.jpg', imgMb: '/images/about_services_mb.jpg', muted: 'block2-f__image--muted', href: pathFor('services', lang) },
  { img: '/images/about_brands.jpg', imgMb: '/images/about_brands_mb.jpg', muted: 'block2-f__image--muted block2-f__image--muted-strong', href: pathFor('brands', lang) },
];
const areas = c.areas.map((a, i) => ({ ...a, ...areaMeta[i] }));
const unionLogos = ['/images/gsn_farma_logo_cropped.png', '/images/coetus_logo_cropped.png'];
const union = {
  title: c.union.title,
  items: c.union.items.map((it, i) => ({ ...it, logo: unionLogos[i] })),
  footer: c.union.footer,
};
const oh = { ...c.oh, img: '/images/one_health_gsnfarma4.jpg' };
const hero = { ...c.hero, img: '/images/gsn_farma_offices_building3.jpg' };
const intro = c.intro;
// Versió vertical d'alta resolució de les imatges de les àrees (per als panells grans de desktop).
const big = (src: string) => src.replace('.jpg', '_mb.jpg');
const areasIntroMix = c.areasIntroMix;
const areasIntro = c.areasIntro;
---

<BaseLayout title={c.title} description={c.description}>
  {/* ===== Capçalera + primer bloc, versió DESKTOP (>=900px): banda de foto neta i fulla blanca que li puja, amb el títol
       (H1) i la línia blava a l'esquerra i el subtítol i el text a la dreta. És el component de capçalera previst per a
       totes les pàgines. A mòbil s'amaga i el substitueix .qs-mhero. ===== */}

  <section class="qd qd-u qd-u--page">
    <div class="qd-u__photo">
      <picture>
        <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.webp" type="image/webp" />
        <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.jpg" />
        <img src={hero.img} alt="" loading="eager" fetchpriority="high" />
      </picture>
    </div>
    <div class="qd-u__sheet">
      <div class="qd-wrap qd-u__grid">
        <div class="qd-u__head">
          <h1>{hero.l1} {hero.l2}</h1>
          <span class="qd-bar" aria-hidden="true"></span>
        </div>
        <div class="qd-u__body">
          <h2>{intro.h2}</h2>
          <p>{intro.p}</p>
        </div>
      </div>
    </div>
  </section>



  {/* ===== Capçalera + primer bloc, versió MÒBIL (<900px): imatge, títol de pàgina, línia blava, subtítol i text
       en una sola peça. A mòbil substitueix la capçalera i el primer bloc de sota (que s'amaguen); a desktop
       només es veuen aquests dos i aquesta peça queda amagada. ===== */}

  <section class="qs-mhero">
    <div class="qs-mhero__img">
      <picture>
        <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.webp" type="image/webp" />
        <source media="(max-width: 899px)" srcset="/images/gsn_farma_offices_building3_hm.jpg" />
        <img src={hero.img} alt="" loading="eager" fetchpriority="high" />
      </picture>
    </div>
    <div class="qs-mhero__sheet">
      <div class="qs-mhero__title" role="heading" aria-level="1"><span>{hero.l1}</span><span>{hero.l2}</span></div>
      <span class="qs-mhero__bar" aria-hidden="true"></span>
      <h2 class="qs-mhero__sub">{intro.h2}</h2>
      <p class="qs-mhero__text">{intro.p}</p>
    </div>
  </section>

  {/* ===== 2. Unión Coetus + GSN, versió DESKTOP (>=900px): línia de temps horitzontal de tres columnes iguals sobre gris, cada una amb el seu punt, la xifra, el logo i el text
       centrats; la 3a és el grup (sense xifra, amb el logo de GSN Farma Labs Group a la mateixa alçada i la frase final). A mòbil s'amaga i el substitueix .qs-munio. ===== */}

  <section class="qd qd-un">
    <div class="qd-wrap qd-un__grid">
      <div class="qd-stack">
        <span class="qd-bar" aria-hidden="true"></span>
        <h2>{union.title}</h2>
      </div>
      <ol class="qd-un__tl">
        {union.items.map((it) => (
          <li>
            <div class="qd-un__head">
              <span class="qd-un__num">{it.n}</span>
              <img class="qd-logo" src={it.logo} alt={it.alt} loading="lazy" />
            </div>
            <p>{it.text}</p>
          </li>
        ))}
        <li>
          <div class="qd-un__head">
            <span class="qd-un__num" aria-hidden="true">&nbsp;</span>
            <img class="qd-logo qd-logo--group" src="/images/gsn_farma_labs_group_logo_cropped.png" alt="GSN Farma Labs Group" loading="lazy" />
          </div>
          <p>{union.footer}</p>
        </li>
      </ol>
    </div>
  </section>

  {/* ===== "Una unión que suma...", versió MÒBIL (<900px): línia de temps amb el logo al costat del número, sobre
       fons gris. A mòbil substitueix la unió de desktop (.qd-un, que s'amaga); a desktop és al revés. ===== */}

  <section class="qs-munio">
    <div class="container">
      <h2 class="qs-munio__title">{union.title}</h2>
      <ol class="qs-tl qs-tl--inline">
        {union.items.map((it) => (
          <li class="qs-tl__item">
            <span class="qs-tl__dot" aria-hidden="true"></span>
            <div class="qs-tl__head">
              <span class="qs-tl__num">{it.n}</span>
              <img class="qs-tl__logo" src={it.logo} alt={it.alt} loading="lazy" />
            </div>
            <p>{it.text}</p>
          </li>
        ))}
        <li class="qs-tl__item qs-tl__item--end">
          <span class="qs-tl__dot qs-tl__dot--end" aria-hidden="true"></span>
          <p>{union.footer}</p>
        </li>
      </ol>
    </div>
  </section>

  {/* ===== 3. Misión / propósito / One Health, versió DESKTOP (>=900px): composició partida sobre blanc amb la foto arrodonida a l'esquerra
       i el títol, el destacat i el text a la dreta. A mòbil s'amaga i el substitueix .qs-moh. ===== */}

  <section class="qd qd-oh">
    <div class="qd-wrap qd-oh__grid">
      <div class="qd-oh__photo"><img src={oh.img} alt={oh.alt} loading="lazy" /></div>
      <div class="qd-oh__text">
        <h2 set:html={oh.title}></h2>
        <span class="qd-bar" aria-hidden="true"></span>
        <p class="qd-oh__lead" set:html={oh.p1}></p>
        <p set:html={oh.p2}></p>
      </div>
    </div>
  </section>

  {/* ===== One Health, versió MÒBIL (<900px): foto amb el títol i la línia blava a sobre i una fulla blanca arrodonida
       amb el text. A mòbil substitueix el bloc de desktop (.qd-oh, que s'amaga); a desktop és al revés. ===== */}

  <section class="qs-moh">
    <div class="qs-moh__photo">
      <img src={oh.img} alt={oh.alt} loading="lazy" />
      <div class="qs-moh__over">
        <h2 set:html={oh.title}></h2>
        <span class="qs-moh__bar" aria-hidden="true"></span>
      </div>
    </div>
    <div class="qs-moh__sheet">
      <p class="qs-moh__lead" set:html={oh.p1}></p>
      <p set:html={oh.p2}></p>
    </div>
  </section>



  {/* ===== "Así sumamos salud", versió MÒBIL (<900px): tancament navy amb cantonades superiors arrodonides, introducció
       a l'esquerra amb la línia blava i dues targetes immersives amb el CTA en text amb ">". A mòbil substitueix el bloc
       de sobre (.qs-areas, que s'amaga); a desktop és al revés. ===== */}

  <section class="qs-mas">
    <div class="container qs-mas__intro">
      <h2>{c.areasTitle}</h2>
      <span class="qs-mas__bar" aria-hidden="true"></span>
      <p set:html={areasIntro}></p>
    </div>
    <div class="container qs-mas__cards">
      {areas.map((a) => (
        <a class="qs-mas__card" href={a.href}>
          <span class={`qs-mas__img ${a.muted}`}>
            <picture>
              <source media="(max-width: 767px)" srcset={a.imgMb} />
              <img src={a.img} alt={a.alt} loading="lazy" />
            </picture>
          </span>
          <span class="qs-mas__body">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <span class="qs-mas__link">{a.cta}<span class="qs-mas__link-arrow" aria-hidden="true">›</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>


  {/* ===== 4. Áreas de negocio, versió DESKTOP (>=900px): bloc navy amb cantonades superiors arrodonides, títol centrat amb la línia cian a sobre i dos
       panells amb foto (zoom i fletxa en passar-hi el ratolí). A mòbil s'amaga i el substitueix .qs-mas. ===== */}

  <section class="qd qd-ag">
    <div class="qd-wrap">
      <div class="qd-ag__head">
        <span class="qd-bar" aria-hidden="true"></span>
        <h2>{c.areasTitle}</h2>
        <p set:html={areasIntroMix}></p>
      </div>
      <div class="qd-ag__panels">
        {areas.map((a) => (
          <a class="qd-ag__panel" href={a.href}>
            <img src={big(a.img)} alt={a.alt} loading="lazy" />
            <div class="qd-ag__body">
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="qd-cta">{a.cta}<span aria-hidden="true">›</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
