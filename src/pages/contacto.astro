---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/contacto.css';
---

<BaseLayout
  title="Contacto | GSN Farma Labs Group"
  description="Contacta con GSN Farma Labs Group para más información sobre nuestro laboratorio farmacéutico, servicios y soluciones de salud."
>
  <Hero title="Contacto" subtitle="Contacta con nosotros" image="/images/hero-contacto.webp" />

  <section class="content-section content-section--split">
    <div class="container content-section__split-inner">
      <div class="content-section__image">
        <img src="/images/contacto-img.webp" alt="" loading="lazy" />
      </div>
      <div class="content-section__text">
        <h2>Cuéntanos en qué podemos ayudarte</h2>
        <p>Si quieres conocer más o explorar una colaboración, contacta con nosotros.</p>
        <ContactForm submitLabel="Enviar consulta" />
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <h2>Información de contacto</h2>
      <dl class="contact-info">
        <div>
          <dt><img src="/images/icon-marker.svg" alt="" aria-hidden="true" /> Dirección</dt>
          <dd>C/ del Llobregat nº 28, Terrassa, Barcelona, 08223</dd>
        </div>
        <div>
          <dt><img src="/images/icon-phone.svg" alt="" aria-hidden="true" /> Teléfono</dt>
          <dd><a href="tel:+34680310655">+34 680 310 655</a></dd>
        </div>
        <div>
          <dt><img src="/images/icon-address.svg" alt="" aria-hidden="true" /> Correo electrónico</dt>
          <dd><a href="mailto:info@gsnfarma.com">info@gsnfarma.com</a></dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
