---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import PageHeaderCentered from '../components/PageHeaderCentered.astro';
import PageHeaderMobile from '../components/PageHeaderMobile.astro';
import '../styles/pages/inner-page.css';
import '../styles/pages/block3-compare.css';
import '../styles/pages/subpage-hero-compare.css';
import '../styles/pages/contact-form-mobile.css';
import '../styles/pages/desktop-page-header.css';
import '../styles/pages/mobile-proposals.css';
import '../styles/pages/contacto-desktop-proposals.css';
import { detectPage } from '../i18n/config';
import { ui } from '../i18n/ui';
import { contact } from '../i18n/contact';

// Contacto en els tres idiomes (l'idioma surt de la ruta); els textos són a src/i18n/contact.ts i ui.ts.
const { lang } = detectPage(Astro.url.pathname);
const c = contact[lang];
const ci = ui[lang].contactItems;
const COUNTRY = { es: 'España', ca: 'Espanya', en: 'Spain' } as const;

// Dades de contacte del bloc de desktop (el LinkedIn és al footer).
const contactInfo = [
  { icon: '/images/icon-marker.svg', title: ci.address, lines: ['C/ del Llobregat 28, 08223.', 'Terrassa, Barcelona, ' + COUNTRY[lang] + '.'], href: 'https://maps.google.com/?q=C/+del+Llobregat+28,+08223+Terrassa' },
  { icon: '/images/icon-phone.svg', title: ci.general, tel: '+34 680 310 655' },
  { icon: '/images/icon-phone.svg', title: ci.pharmacovigilance, tel: '+34 680 310 655' },
  { icon: '/images/icon-address.svg', title: ci.email, mail: 'info@gsnfarma.com' },
];
---

<BaseLayout title={c.title} description={c.description}>
  {/* Capçalera de MÒBIL (<900px): foto de 220px SENSE degradat i fulla blanca arrodonida amb el títol, la barra cian i el subtítol, a l'esquerra (PageHeaderMobile.astro; mateix text que la proposta de desktop). A desktop s'amaga. */}
  <PageHeaderMobile title={c.header.title} text={c.header.sub} img="/images/gsn_farma_offices_hall2_hm" />

  {/* Capçalera de DESKTOP (>=900px), definitiva: com la de Quiénes somos (PageHeaderCentered.astro): foto sense degradat i fulla blanca amb la barra cian, el títol (H1) i el subtítol, centrats. A mòbil s'amaga i el substitueix PageHeaderMobile. */}
  <PageHeaderCentered img="/images/gsn_farma_offices_hall3.jpg" pos={92} title={c.header.title} subtitle={c.header.sub} />

  {/* Dades de contacte i formulari, versió DESKTOP (>=900px): dades alineades amb el títol i formulari en una targeta grisa arrodonida que arriba fins al marge dret de la capçalera. A mòbil s'amaga i el substitueixen .sp-cf i .sp-cd. */}
  <section class="qd qd-cf">
    <div class="qd-cf__bg" aria-hidden="true"></div>
    <div class="qd-cf__info">
      <div class="qd-cf__list">
        {contactInfo.map((i) => (
          <div class="qd-cf__item">
            <img class="qd-cf__icon" src={i.icon} alt="" aria-hidden="true" />
            <div>
              <h3>{i.title}</h3>
              <p>{i.tel ? <a href={`tel:${i.tel.replace(/ /g, '')}`}>{i.tel}</a> : i.mail ? <a href={`mailto:${i.mail}`}>{i.mail}</a> : <a href={i.href} target="_blank" rel="noopener noreferrer">{i.lines[0]}<br />{i.lines[1]}</a>}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="qd-cf__form"><ContactForm requiredNote={true} /></div>
  </section>

  {/* Formulari (mòbil <900px): reutilitza .contact-2col (contact-form-mobile.css), alineat a l'esquerra amb el marge de 16px de la resta de la pàgina. S'amaga a desktop. */}
  <section class="sp sp-cf">
    <div class="container">
      <div class="contact-2col">
        <ContactForm />
      </div>
    </div>
  </section>

  {/* Dades de contacte (mòbil <900px): graella 2×2 alineada a l'esquerra (Dirección | Correo, Información general | Farmacovigilancia); LinkedIn és al peu. A desktop es veu el bloc .qd-cf. */}
  <section class="sp sp-cd">
    <div class="container">
      <div class="sp-cd__items">
        <div class="sp-cd__item">
          <img src="/images/icon-marker.svg" alt="" aria-hidden="true" />
          <p class="sp-cd__label">{ci.address}</p>
          <p><a href="https://maps.google.com/?q=C/+del+Llobregat+28,+08223+Terrassa" target="_blank" rel="noopener noreferrer">C/ del Llobregat 28,<br />08223. Terrassa,<br />Barcelona, {COUNTRY[lang]}.</a></p>
        </div>
        <div class="sp-cd__item">
          <img src="/images/icon-address.svg" alt="" aria-hidden="true" />
          <p class="sp-cd__label">{ci.email}</p>
          <p><a href="mailto:info@gsnfarma.com">info@gsnfarma.com</a></p>
        </div>
        <div class="sp-cd__item">
          <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
          <p class="sp-cd__label">{ci.general}</p>
          <p><a href="tel:+34680310655">+34 680 310 655</a></p>
        </div>
        <div class="sp-cd__item">
          <img src="/images/icon-phone.svg" alt="" aria-hidden="true" />
          <p class="sp-cd__label">{ci.pharmacovigilance}</p>
          <p><a href="tel:+34680310655">+34 680 310 655</a></p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
